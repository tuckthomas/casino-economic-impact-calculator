{
  "name": "savenein",
  "version": "0.9.1",
  "description": "SaveNEIN - Economic Impact Analysis",
  "scripts": {
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-vps-development-server.ps1",
    "dev:start": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-vps-development-server.ps1 -Background",
    "dev:stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-vps-development-server.ps1 -Action Stop",
    "dev:restart": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-vps-development-server.ps1 -Action Stop; pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-vps-development-server.ps1 -Background",
    "dev:status": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-vps-development-server.ps1 -Action Status",
    "validate:container": "docker compose --env-file deploy/.env --env-file .env.development -f compose.development.yml build app",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "check:ui-text": "node scripts/check-ui-text-size.mjs",
    "build:css": "tailwindcss -i ./SaveNEIN.Client/Styles/app.css -o ./SaveNEIN.Client/wwwroot/css/app.css --minify",
    "copy-libs": "node scripts/copy-libs.mjs",
    "check:tooltips": "node scripts/check-tooltips.mjs",
    "check:model-license": "node scripts/check-model-license.mjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.30",
    "@fontsource-variable/public-sans": "^5.2.7",
    "browserslist": "^4.28.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  }
}
