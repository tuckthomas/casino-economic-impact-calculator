{
  "name": "savenein",
  "version": "0.9.1",
  "description": "SaveNEIN - Economic Impact Analysis",
  "scripts": {
    "dev": "./scripts/dev/dev-start.sh --foreground",
    "dev:start": "./scripts/dev/dev-start.sh",
    "dev:stop": "./scripts/dev/dev-stop.sh",
    "dev:restart": "./scripts/dev/dev-restart.sh",
    "dev:status": "./scripts/dev/dev-status.sh",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "check:ui-text": "node scripts/check-ui-text-size.mjs",
    "build:css": "tailwindcss --config ./SaveNEIN.Client/tailwind.config.js -i ./SaveNEIN.Client/Styles/app.css -o ./SaveNEIN.Client/wwwroot/css/app.css --minify",
    "copy-libs": "node scripts/copy-libs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.30",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@turf/turf": "^7.3.1",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001764",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "terra-draw": "^1.22.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  }
}
