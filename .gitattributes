# Validation checksums describe captured bytes, including source line endings.
# Preserve them across Windows/Linux checkouts instead of applying autocrlf.
docs/validation/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/validation/bundles/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/validation/bundles/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
