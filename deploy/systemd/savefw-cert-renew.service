[Unit]
Description=Renew SaveFW TLS certificate
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/save-nein/app/deploy
ExecStart=/usr/bin/docker compose --env-file /opt/save-nein/deploy/.env -f compose.production.yml run --rm certbot renew --webroot --webroot-path /var/www/certbot --quiet
ExecStartPost=-/usr/bin/docker compose --env-file /opt/save-nein/deploy/.env -f compose.production.yml exec -T nginx nginx -s reload
