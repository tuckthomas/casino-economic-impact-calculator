# Copy this file to deploy/.env and fill in private values. deploy/.env is ignored by Git.
# Do not commit credentials, recipient addresses, database passwords, or archive tokens.

# Database
POSTGRES_PASSWORD=

# Daily registration digest (Eastern Time, Indiana)
DAILY_SIGNUP_DIGEST_ENABLED=false
DAILY_SIGNUP_DIGEST_TIME_ZONE_ID=America/Indiana/Indianapolis
DAILY_SIGNUP_DIGEST_DELIVERY_LOCAL_TIME=08:00
DAILY_SIGNUP_DIGEST_SENDER_ADDRESS=outreach@savefw.com
# Comma-delimited list; leave blank to disable delivery until configured.
DAILY_SIGNUP_DIGEST_RECIPIENTS=

# Zoho Mail API credentials for the sender account
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com/api/
ZOHO_MAIL_TOKEN_ENDPOINT=https://accounts.zoho.com/oauth/v2/token

# Private claimant-source archiving service
ARCHIVEBOX_ENABLED=false
ARCHIVEBOX_ADMIN_USERNAME=savenein
ARCHIVEBOX_ADMIN_PASSWORD=
ARCHIVEBOX_API_TOKEN=
ARCHIVEBOX_CAPTURE_ADMIN_TOKEN=
