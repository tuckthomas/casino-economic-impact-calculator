@page "/"
@using System.Text.Json
@using SaveNEIN.Client.Models
@{
    var clientBuildVersion = typeof(SaveNEIN.Client.App).Assembly.ManifestModule.ModuleVersionId.ToString("N");
    var request = ViewContext.HttpContext.Request;
    var factCheckSlug = request.Path.Value?
        .Split('/', StringSplitOptions.RemoveEmptyEntries)
        .SkipWhile(segment => !segment.Equals("fact-checks", StringComparison.OrdinalIgnoreCase))
        .Skip(1)
        .FirstOrDefault();

    FactCheckClaim? sharedFactCheck = null;
    if (!string.IsNullOrWhiteSpace(factCheckSlug))
    {
        using var factCheckStream = typeof(SaveNEIN.Client.App).Assembly
            .GetManifestResourceStream("SaveNEIN.Client.Data.fact-checks.json");
        if (factCheckStream is not null)
        {
            var factChecks = JsonSerializer.Deserialize<FactCheckDocument>(factCheckStream, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            sharedFactCheck = factChecks?.FactChecks.FirstOrDefault(claim =>
                claim.Slug.Equals(factCheckSlug, StringComparison.OrdinalIgnoreCase));
        }
    }

    var publicOrigin = $"{request.Scheme}://{request.Host}";
    var sharedFactCheckUrl = sharedFactCheck is null ? null : $"{publicOrigin}/fact-checks/{Uri.EscapeDataString(sharedFactCheck.Slug)}";
    var sharedFactCheckImageUrl = sharedFactCheck is null
        ? null
        : $"{publicOrigin}/fact-checks/{Uri.EscapeDataString(sharedFactCheck.Slug)}/share.png";
    var sharedFactCheckTitle = sharedFactCheck is null
        ? null
        : $"Fact Check: {sharedFactCheck.ClaimText} | Rating: {VerdictLabel(sharedFactCheck.Verdict)} | SaveNEIN";
    var sharedFactCheckDescription = sharedFactCheck is null
        ? null
        : $"{sharedFactCheck.DetailedExplanation}\n\nKey facts:\n{string.Join("\n", sharedFactCheck.KeyFacts.Select(fact => $"- {fact}"))}";

    static string VerdictLabel(FactCheckVerdict verdict) => verdict switch
    {
        FactCheckVerdict.True => "TRUE",
        FactCheckVerdict.MostlyTrue => "MOSTLY TRUE",
        FactCheckVerdict.MostlyFalse => "MOSTLY FALSE",
        FactCheckVerdict.False => "FALSE",
        _ => "UNRATED"
    };
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(sharedFactCheckTitle ?? "Save Northeast Indiana - Protect Our Future")</title>
    <base href="/" />

    @if (sharedFactCheck is not null)
    {
        <meta name="description" content="@sharedFactCheckDescription" />
        <link rel="canonical" href="@sharedFactCheckUrl" />
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="SaveNEIN" />
        <meta property="og:title" content="@sharedFactCheckTitle" />
        <meta property="og:description" content="@sharedFactCheckDescription" />
        <meta property="og:url" content="@sharedFactCheckUrl" />
        <meta property="og:image" content="@sharedFactCheckImageUrl" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@sharedFactCheckTitle" />
        <meta name="twitter:description" content="@sharedFactCheckDescription" />
        <meta name="twitter:image" content="@sharedFactCheckImageUrl" />
    }

    <style>
        /*
           Critical first paint. Keep this visually aligned with the real hero so the
           browser never shows the old flat slate/blue loading screen while Blazor and
           the heavier JavaScript libraries are still starting.
        */
        html,
        body,
        #app {
            min-height: 100%;
            margin: 0;
            background-color: #070c18;
            background-image:
                radial-gradient(ellipse 62% 72% at 3% 104%, rgba(80, 5, 12, 0.20) 0%, rgba(80, 5, 12, 0.08) 34%, transparent 66%),
                radial-gradient(ellipse 46% 55% at 94% 3%, rgba(30, 41, 59, 0.34) 0%, rgba(15, 23, 42, 0.12) 48%, transparent 72%),
                linear-gradient(115deg, #080914 0%, #07101e 50%, #0b1424 100%);
        }

        #app {
            min-height: 100svh;
        }

        .startup-hero-backdrop {
            position: fixed;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            background-color: #070c18;
            background-image:
                radial-gradient(ellipse 62% 72% at 3% 104%, rgba(80, 5, 12, 0.20) 0%, rgba(80, 5, 12, 0.08) 34%, transparent 66%),
                radial-gradient(ellipse 46% 55% at 94% 3%, rgba(30, 41, 59, 0.34) 0%, rgba(15, 23, 42, 0.12) 48%, transparent 72%),
                linear-gradient(115deg, #080914 0%, #07101e 50%, #0b1424 100%);
        }

        .startup-hero-backdrop::before {
            content: "";
            position: absolute;
            width: 172%;
            height: 176%;
            left: -43%;
            bottom: -66%;
            opacity: 0.78;
            filter: blur(18px);
            background-image:
                radial-gradient(ellipse 16% 11% at 24% 61%, rgba(2, 6, 23, 0.66) 0%, rgba(2, 6, 23, 0.24) 48%, transparent 72%),
                radial-gradient(ellipse 13% 9% at 36% 70%, rgba(2, 6, 23, 0.55) 0%, rgba(2, 6, 23, 0.18) 50%, transparent 72%),
                radial-gradient(ellipse 29% 18% at 17% 71%, rgba(80, 5, 12, 0.82) 0%, rgba(80, 5, 12, 0.42) 34%, rgba(80, 5, 12, 0.10) 62%, transparent 78%),
                radial-gradient(ellipse 24% 14% at 30% 76%, rgba(120, 10, 20, 0.58) 0%, rgba(80, 5, 12, 0.28) 38%, rgba(80, 5, 12, 0.07) 64%, transparent 77%),
                radial-gradient(ellipse 18% 11% at 9% 82%, rgba(185, 28, 28, 0.36) 0%, rgba(120, 10, 20, 0.18) 38%, transparent 72%);
        }


        /* Meaningful, immediately usable content before the WebAssembly runtime starts. */
        .startup-hero-content {
            position: relative;
            z-index: 1;
            box-sizing: border-box;
            min-height: 100svh;
            max-width: 96rem;
            margin: auto;
            padding: clamp(1rem, 3vw, 2.5rem);
            color: #fff;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        }
        .startup-hero-content img {
            display: block;
            width: min(74vw, 17.5rem);
            height: auto;
            margin-bottom: 1.5rem;
        }
        .startup-hero-content h1 {
            font-size: clamp(2rem, 8.7vw, 4.25rem);
            line-height: 1.04;
            font-weight: 900;
            letter-spacing: -0.035em;
            margin: 0 0 1rem;
        }
        .startup-hero-content h1 span,
        .startup-hero-content p {
            color: #f43f5e;
        }
        .startup-hero-content p {
            margin: 0 0 1.75rem;
            font-size: clamp(1.1rem, 5vw, 1.6rem);
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.035em;
        }
        .startup-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }
        .startup-hero-actions a {
            display: inline-block;
            padding: 0.8rem 1.2rem;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 0.6rem;
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            background: rgba(15,23,42,.85);
        }
        .startup-hero-actions a:first-child {
            background: #be123c;
            border-color: #be123c;
        }
        @media (min-width: 1024px) {
            .startup-hero-content { padding-top: clamp(3.5rem, 11vh, 8rem); }
        }

        html {
            overflow-y: scroll;
        }

        ::-webkit-scrollbar {
            width: 16px;
            height: 16px;
        }

        ::-webkit-scrollbar-track {
            background-color: rgba(15, 23, 42, 0.6);
        }

        ::-webkit-scrollbar-thumb {
            background-color: rgba(71, 85, 105, 0.5);
            border-radius: 8px;
            border: 4px solid transparent;
            background-clip: content-box;
            transition: background-color 0.2s;
        }

        ::-webkit-scrollbar-thumb:hover {
            background-color: rgba(148, 163, 184, 0.8);
        }

        ::-webkit-scrollbar-button:single-button {
            background-color: rgba(15, 23, 42, 0.6);
            display: block;
            border-style: solid;
            height: 16px;
            width: 16px;
        }

        ::-webkit-scrollbar-button:single-button:horizontal:decrement,
        ::-webkit-scrollbar-button:single-button:horizontal:increment,
        ::-webkit-scrollbar-button:single-button:vertical:decrement {
            border-width: 0px 8px 8px 8px;
            border-color: transparent transparent #555555 transparent;
        }

        ::-webkit-scrollbar-button:single-button:vertical:decrement:hover {
            border-color: transparent transparent #777777 transparent;
        }

        ::-webkit-scrollbar-button:single-button:vertical:increment {
            border-width: 8px 8px 0px 8px;
            border-color: #555555 transparent transparent transparent;
        }

        ::-webkit-scrollbar-button:single-button:vertical:increment:hover {
            border-color: #777777 transparent transparent transparent;
        }

        ::-webkit-scrollbar-button:single-button:vertical:decrement {
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' fill='rgb(148, 163, 184)'><polygon points='50,15 15,85 85,85'/></svg>");
            background-size: 10px;
            background-position: center;
            background-repeat: no-repeat;
            border: none;
        }

        ::-webkit-scrollbar-button:single-button:vertical:increment {
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' fill='rgb(148, 163, 184)'><polygon points='15,15 85,15 50,85'/></svg>");
            background-size: 10px;
            background-position: center;
            background-repeat: no-repeat;
            border: none;
        }

        ::-webkit-scrollbar-button:vertical:single-button:hover {
            background-color: rgba(30, 41, 59, 0.8);
        }
    </style>

    <link rel="preload" href="assets/SaveNEIN_SVG_Dark_Mode_Small.svg" as="image" type="image/svg+xml" />
    <link href="lib/public-sans/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="lib/material-symbols-outlined/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/app.css" rel="stylesheet" asp-append-version="true" />
    <link href="SaveNEIN.Client.styles.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/atmospheric-backgrounds.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/hero-entry-sequence.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32x32.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="assets/site.webmanifest" asp-append-version="true" />
</head>

<body class="text-slate-300 antialiased font-display overflow-x-hidden">
    <div id="app">
        <div class="startup-hero-backdrop" aria-hidden="true"></div>
        <div class="startup-hero-content">
            <img src="assets/SaveNEIN_SVG_Dark_Mode_Small.svg" alt="Save Northeast Indiana" width="280" height="125" />
            <h1>DON'T LET THEM<br /><span>GAMBLE AWAY</span><br />OUR REGION'S<br />FUTURE.</h1>
            <p>Northeast Indiana Deserves Better.</p>
            <div class="startup-hero-actions">
                <a href="/get-involved">Get Involved</a>
                <a href="/fact-checks">Fact Checks</a>
            </div>
        </div>
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

    <script>
        window.slotMachineSafeInit = function (mobileMaxWidth, mobileRevealDelayMs)
        {
            let attempts = 0;
            const maxAttempts = 120;
            const delayMs = 50;

            const tryInit = () =>
            {
                const api = window.SlotMachine;
                if (api && typeof api.init === 'function')
                {
                    api.init(mobileMaxWidth, mobileRevealDelayMs);
                    return true;
                }
                return false;
            };

            if (tryInit()) return;

            const timer = setInterval(() =>
            {
                attempts++;
                if (tryInit() || attempts >= maxAttempts)
                {
                    clearInterval(timer);
                }
            }, delayMs);
        };
    </script>

    @* Report-viewer libraries load after first paint. *@
    <script src="js/lib/pdf.min.js" asp-append-version="true" defer></script>
    <script src="js/lib/page-flip.browser.js" asp-append-version="true" defer></script>

    <script src="js/components/slot-machine.js" asp-append-version="true" defer></script>
    <script src="js/components/adaptive-toast.js" asp-append-version="true" defer></script>
    <script src="js/components/legislators.js" asp-append-version="true" defer></script>
    <script src="js/components/image-modal.js" asp-append-version="true" defer></script>
    <script src="js/components/modals.js" asp-append-version="true" defer></script>
    <script src="js/components/flipbook.js" asp-append-version="true" defer></script>
    <script src="js/components/toc.js" asp-append-version="true" defer></script>
    <script src="js/components/reveal.js" asp-append-version="true" defer></script>
    <script src="js/components/tooltip-portal.js" asp-append-version="true" defer></script>
    <script src="js/components/slider-input-logic.js" asp-append-version="true" defer></script>
    <script src="js/components/home-header.js" asp-append-version="true" defer></script>
    <script src="js/components/fact-check-layout.js" asp-append-version="true" defer></script>
    <script src="js/components/app-button-depth.js" asp-append-version="true" defer></script>
    <script src="js/components/fact-check-share.js" asp-append-version="true" defer></script>

    <script src="js/lib/chart.js" asp-append-version="true" defer></script>
    <link rel="stylesheet" href="css/maplibre-gl.css" asp-append-version="true" />
    <script src="js/components/charts.js" asp-append-version="true" defer></script>
    <script src="js/economics/substitution.js" asp-append-version="true" defer></script>

    <script>
        window.ensureEconomicCalculator = function () {
            if (window.EconomicCalculator) return Promise.resolve(true);
            if (window.__economicCalculatorLoad) return window.__economicCalculatorLoad;
            window.__economicCalculatorLoad = new Promise(function (resolve, reject) {
                const script = document.createElement('script');
                script.src = '/js/economics/calculator.js?v=20261008-route-loading';
                script.onload = function () { resolve(!!window.EconomicCalculator); };
                script.onerror = function () { reject(new Error('Calculator script could not load')); };
                document.head.appendChild(script);
            }).catch(function (error) {
                console.error('Calculator assets failed to load:', error);
                window.__economicCalculatorLoad = null;
                return false;
            });
            return window.__economicCalculatorLoad;
        };

        window.ensureMapLibreImpactMap = function () {
            if (window.MapLibreImpactMap) return Promise.resolve(true);
            if (window.__mapLibreImpactMapLoad) return window.__mapLibreImpactMapLoad;

            // Maps are only needed on the economic-impact location page. Do not
            // make every homepage visitor download and evaluate these large files.
            const scripts = [
                '/js/lib/maplibre-gl.js',
                '/js/lib/pmtiles.js',
                '/js/lib/turf.min.js',
                '/js/lib/terra-draw.umd.js',
                '/js/components/maplibre-map.js'
            ];
            const loadScript = function (url) {
                return new Promise(function (resolve, reject) {
                    const script = document.createElement('script');
                    script.src = url + '?v=20261008-route-loading';
                    script.onload = resolve;
                    script.onerror = function () { reject(new Error('Could not load ' + url)); };
                    document.head.appendChild(script);
                });
            };

            window.__mapLibreImpactMapLoad = (async function () {
                for (const path of scripts) await loadScript(path);
                if (!window.MapLibreImpactMap) throw new Error('Map initialization module unavailable');
                return true;
            })().catch(function (error) {
                console.error('Map assets failed to load:', error);
                window.__mapLibreImpactMapLoad = null; // Allow a future retry.
                return false;
            });
            return window.__mapLibreImpactMapLoad;
        };
    </script>

    @* Start Blazor only after every JS interop module is available. Version every boot resource
       with the compiled client MVID so a deployment cannot reuse an older boot manifest. *@
    <script src="_framework/blazor.webassembly.js" asp-append-version="true" autostart="false" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Blazor.start({
            loadBootResource: (_, __, defaultUri) => {
                const resourceUrl = new URL(defaultUri, document.baseURI);
                resourceUrl.searchParams.set("build", "@clientBuildVersion");
                return resourceUrl.toString();
            }
            }).catch(function (error) { console.error('Blazor startup failed:', error); });
        });
    </script>
</body>

</html>
