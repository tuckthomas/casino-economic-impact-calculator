# Copy this file to the Git-ignored .env.development. Also copy
# deploy/.env.example to deploy/.env and configure the private VPS credentials
# there. These optional values select VPS development services reached through
# local SSH tunnels.
DEV_DATABASE_HOST=host.docker.internal
DEV_DATABASE_PORT=15434
DEV_DATABASE_NAME=savefw_dev
DEV_DATABASE_USERNAME=savefw_app
DEV_VALHALLA_BASE_URL=http://host.docker.internal:18002
