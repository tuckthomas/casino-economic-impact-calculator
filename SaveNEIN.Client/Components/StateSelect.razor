@namespace SaveNEIN.Client.Components
@inject IJSRuntime JSRuntime

<div class="relative block">
    <select id="@Id"
            value="@Value"
            @onchange="HandleNativeChanged"
            aria-hidden="true"
            tabindex="-1"
            class="hidden">
        <option value="">Select State...</option>
        @foreach (var state in USStates)
        {
            <option value="@state.Value">@state.Key</option>
        }
    </select>
    
    <!-- Trigger Button (Matches InputText height & styling) -->
    <button type="button"
            id="@(Id)-trigger"
            class="sfw-modern-select sfw-modern-select-trigger w-full h-[50px] min-h-[50px] px-4 py-3 text-sm bg-slate-900/95 border border-slate-600 rounded-xl flex items-center justify-between shadow-sm hover:bg-slate-700/60 transition-all focus:outline-none focus:ring-2 focus:ring-accent group relative z-[100]"
            aria-label="State or Province"
            aria-haspopup="listbox"
            aria-expanded="@isOpen"
            @onclick="ToggleMenu">
        @if (string.IsNullOrEmpty(Value))
        {
            <span class="text-slate-500 font-normal truncate">Select State...</span>
        }
        else
        {
            <span class="text-white font-medium truncate">@GetStateName(Value)</span>
        }
        <span class="material-symbols-outlined text-[18px] transition-transform @(isOpen ? "rotate-180" : "") text-slate-400 group-hover:text-slate-200">expand_more</span>
    </button>
    
    @if (isOpen)
    {
        <div class="fixed inset-0 z-[110]" aria-hidden="true" @onclick="CloseMenu"></div>
        <div role="listbox" class="absolute top-full left-0 w-full mt-2 bg-slate-900/95 backdrop-blur-xl border border-slate-700 rounded-xl shadow-2xl overflow-hidden transform origin-top transition-all duration-200 z-[120]">
            <!-- Search / Filter Input (Automatically focused on expansion) -->
            <div class="p-2.5 border-b border-slate-700 bg-slate-900/95 sticky top-0 z-10">
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3 text-slate-400 text-[18px]" aria-hidden="true">search</span>
                    <input type="text"
                           id="@(Id)-search-input"
                           @ref="searchInputRef"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown"
                           placeholder="Type to filter (e.g. IN, Indiana)..."
                           autofocus
                           class="w-full bg-slate-800 border border-slate-700 rounded-lg pl-9 pr-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-accent" />
                </div>
            </div>

            <!-- Scrollable State List -->
            <div class="max-h-56 overflow-y-auto overscroll-contain scrollbar-thin scrollbar-thumb-slate-600 scrollbar-track-transparent">
                @if (!FilteredStates.Any())
                {
                    <div class="p-4 text-center text-sm text-slate-400">No states match "@searchTerm"</div>
                }
                else
                {
                    @foreach (var state in FilteredStates)
                    {
                        var isActive = string.Equals(Value, state.Value, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="w-full text-left px-4 py-2.5 text-sm transition-colors hover:bg-slate-800 hover:text-white flex items-center justify-between group @(isActive ? "bg-slate-800 text-accent font-bold" : "text-slate-200 font-medium")"
                                @onclick="(() => SelectState(state.Value))">
                            <span>@state.Key</span>
                            <span class="text-sm font-mono text-slate-400 bg-slate-800 group-hover:bg-slate-700 px-2 py-0.5 rounded transition-colors">@state.Value</span>
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool isOpen;
    private string searchTerm = string.Empty;
    private ElementReference searchInputRef;
    private bool shouldFocusSearch;

    private IEnumerable<KeyValuePair<string, string>> FilteredStates =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? USStates
            : USStates.Where(s => s.Key.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                  s.Value.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void ToggleMenu()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            shouldFocusSearch = true;
        }
        else
        {
            searchTerm = string.Empty;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isOpen && shouldFocusSearch)
        {
            shouldFocusSearch = false;
            try
            {
                await searchInputRef.FocusAsync();
            }
            catch
            {
                // Fallback for JS interop focus
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{Id}-search-input')?.focus()");
            }
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            var first = FilteredStates.FirstOrDefault();
            if (!string.IsNullOrEmpty(first.Value))
            {
                _ = SelectState(first.Value);
            }
        }
        else if (args.Key == "Escape")
        {
            CloseMenu();
        }
    }

    private void CloseMenu()
    {
        isOpen = false;
        searchTerm = string.Empty;
    }

    private async Task SelectState(string stateValue)
    {
        Value = stateValue;
        isOpen = false;
        searchTerm = string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private void HandleNativeChanged(ChangeEventArgs args)
    {
        Value = args.Value?.ToString() ?? string.Empty;
        isOpen = false;
        searchTerm = string.Empty;
        ValueChanged.InvokeAsync(Value);
    }

    private string GetStateName(string value)
    {
        var state = USStates.FirstOrDefault(s => s.Value == value);
        return state.Key ?? value;
    }

    private static readonly Dictionary<string, string> USStates = new()
    {
        { "Alabama", "AL" }, { "Alaska", "AK" }, { "Arizona", "AZ" }, { "Arkansas", "AR" },
        { "California", "CA" }, { "Colorado", "CO" }, { "Connecticut", "CT" }, { "Delaware", "DE" },
        { "District of Columbia", "DC" }, { "Florida", "FL" }, { "Georgia", "GA" }, { "Hawaii", "HI" },
        { "Idaho", "ID" }, { "Illinois", "IL" }, { "Indiana", "IN" }, { "Iowa", "IA" },
        { "Kansas", "KS" }, { "Kentucky", "KY" }, { "Louisiana", "LA" }, { "Maine", "ME" },
        { "Maryland", "MD" }, { "Massachusetts", "MA" }, { "Michigan", "MI" }, { "Minnesota", "MN" },
        { "Mississippi", "MS" }, { "Missouri", "MO" }, { "Montana", "MT" }, { "Nebraska", "NE" },
        { "Nevada", "NV" }, { "New Hampshire", "NH" }, { "New Jersey", "NJ" }, { "New Mexico", "NM" },
        { "New York", "NY" }, { "North Carolina", "NC" }, { "North Dakota", "ND" }, { "Ohio", "OH" },
        { "Oklahoma", "OK" }, { "Oregon", "OR" }, { "Pennsylvania", "PA" }, { "Rhode Island", "RI" },
        { "South Carolina", "SC" }, { "South Dakota", "SD" }, { "Tennessee", "TN" }, { "Texas", "TX" },
        { "Utah", "UT" }, { "Vermont", "VT" }, { "Virginia", "VA" }, { "Washington", "WA" },
        { "West Virginia", "WV" }, { "Wisconsin", "WI" }, { "Wyoming", "WY" }
    };
}
