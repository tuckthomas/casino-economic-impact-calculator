@using SaveNEIN.Client.Components

@if (IsVisible)
{
    <div class="fixed inset-0 z-[9999]">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @onclick="Close"></div>
        
        <!-- Modal Container -->
        <div class="absolute inset-4 md:inset-8 lg:inset-16 flex items-center justify-center pointer-events-none">
            <div class="relative bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-2xl w-full overflow-hidden pointer-events-auto flex flex-col" style="height: 400px;">
                
                <!-- Header -->
                <div class="flex items-center justify-between p-4 border-b border-slate-200 dark:border-slate-700 shrink-0">
                    <h3 class="text-lg font-black text-red-600 uppercase tracking-wide">@CurrentItem.Title</h3>
                    <button @onclick="Close" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-full transition-colors">
                        <span class="material-symbols-outlined text-slate-500">close</span>
                    </button>
                </div>
                
                <!-- Content -->
                <div class="flex-1 overflow-y-auto p-6">
                    <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
                        @((MarkupString)CurrentItem.Content)
                    </p>
                    @if (!string.IsNullOrEmpty(CurrentItem.Source))
                    {
                        <a href="@CurrentItem.Source" target="_blank" class="mt-4 text-red-600 hover:text-red-700 font-bold text-sm flex items-center gap-1">
                            Source <span class="material-symbols-outlined text-sm">open_in_new</span>
                        </a>
                    }
                </div>
                
                <!-- Footer with Navigation -->
                <div class="flex items-center justify-between p-4 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 shrink-0">
                    <!-- Prev Button -->
                    <AppButton OnButtonClick="Prev" Disabled="@(CurrentIndex == 0)" Icon="arrow_back_ios_new">
                        <span class="hidden sm:inline">Previous</span>
                    </AppButton>
                    
                    <!-- Pagination -->
                    <span class="text-sm text-slate-500 dark:text-slate-400 font-medium">@(CurrentIndex + 1) of @CurrentItems.Count</span>
                    
                    <!-- Next Button -->
                    <AppButton OnButtonClick="Next" Disabled="@(CurrentIndex == CurrentItems.Count - 1)" Class="bg-red-600 hover:bg-red-700 text-white flex-row-reverse">
                        <span class="hidden sm:inline">Next</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward_ios</span>
                    </AppButton>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public bool IsVisible { get; private set; }
    private string CurrentCategory { get; set; } = string.Empty;
    private int CurrentIndex { get; set; } = 0;

    private List<RealityItem> CurrentItems => RealityData.TryGetValue(CurrentCategory, out var items) ? items : new List<RealityItem>();
    private RealityItem CurrentItem => CurrentItems.Count > 0 && CurrentIndex >= 0 && CurrentIndex < CurrentItems.Count ? CurrentItems[CurrentIndex] : new RealityItem();

    public void Open(string categoryId)
    {
        CurrentCategory = categoryId;
        CurrentIndex = 0;
        IsVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private void Next()
    {
        if (CurrentIndex < CurrentItems.Count - 1)
        {
            CurrentIndex++;
            StateHasChanged();
        }
    }

    private void Prev()
    {
        if (CurrentIndex > 0)
        {
            CurrentIndex--;
            StateHasChanged();
        }
    }

    public class RealityItem
    {
        public string Title { get; set; } = "";
        public string Content { get; set; } = "";
        public string? Source { get; set; }
    }

    private static readonly Dictionary<string, List<RealityItem>> RealityData = new()
    {
        {
            "economic-engine", new List<RealityItem>
            {
                new() {
