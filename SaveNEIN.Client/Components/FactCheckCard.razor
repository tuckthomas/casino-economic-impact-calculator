@using SaveNEIN.Client.Models

<li class="fact-check-card" id="fact-check-@Claim.Slug">
    <article class="fact-check-card__article" aria-labelledby="fact-check-finding-@Claim.Id">
        <div class="fact-check-card__topline">
            <span class="fact-check-card__category">@Claim.Category</span>
            @if (Claim.IssueTags.Count > 0)
            {
                <div class="fact-check-card__tags" aria-label="Finding qualifiers">
                    @foreach (var tag in Claim.IssueTags)
                    {
                        <span>@tag</span>
                    }
                </div>
            }
        </div>

        <section class="fact-check-card__finding" aria-label="Evidence-backed finding">
            <p class="fact-check-card__finding-label">The evidence shows</p>
            <h4 id="fact-check-finding-@Claim.Id">@Claim.FindingHeadline</h4>
            <p class="fact-check-card__finding-summary">@Claim.ShortFinding</p>
        </section>

        <section class="fact-check-card__claim" aria-label="Claim being checked">
            <div class="fact-check-card__claim-copy">
                <p class="fact-check-card__claim-label">Claim being checked</p>
                <p class="fact-check-card__claimant">@(Claim.IsDirectQuote ? $"{Claim.Claimant} claim" : $"{Claim.Claimant} framing")</p>
                <p class="fact-check-card__claim-text">
                    @if (Claim.IsDirectQuote)
                    {
                        <span>&ldquo;@Claim.ClaimText&rdquo;</span>
                    }
                    else
                    {
                        <span>@Claim.ClaimText</span>
                    }
                </p>
            </div>
            <div class="fact-check-card__rating">
                <span class="fact-check-card__rating-label">Claim rating</span>
                <FactCheckGauge Verdict="Claim.Verdict" />
            </div>
        </section>

        <details class="fact-check-card__details">
            <summary>View evidence &amp; sources</summary>
            <div class="fact-check-card__details-body">
                @foreach (var paragraph in DetailParagraphs)
                {
                    <p>@paragraph</p>
                }

                @if (Claim.KeyFacts.Count > 0)
                {
                    <ul class="fact-check-card__key-facts">
                        @foreach (var fact in Claim.KeyFacts)
                        {
                            <li>@fact</li>
                        }
                    </ul>
                }

                @foreach (var table in Claim.EvidenceTables)
                {
                    <div class="fact-check-card__table-wrap">
                        <table>
                            <caption>@table.Caption</caption>
                            <thead>
                                <tr>
                                    @foreach (var header in table.Headers)
                                    {
                                        <th scope="col">@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in table.Rows)
                                {
                                    <tr>
                                        @for (var i = 0; i < row.Count; i++)
                                        {
                                            if (i == 0)
                                            {
                                                <th scope="row">@row[i]</th>
                                            }
                                            else
                                            {
                                                <td>@row[i]</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="fact-check-card__sources">
                    <p class="fact-check-card__detail-heading">Sources</p>
                    <ul>
                        @foreach (var source in Claim.Sources)
                        {
                            <li>
                                @if (!string.IsNullOrWhiteSpace(source.Url))
                                {
                                    <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Label</a>
                                }
                                else
                                {
                                    <strong>@source.Label</strong>
                                }
                                <span> — @source.Citation</span>
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrWhiteSpace(ClaimantSourceUrl))
                    {
                        <a class="fact-check-card__claim-source" href="@ClaimantSourceUrl" target="_blank" rel="noopener noreferrer">
                            @ClaimantSourceLabel
                            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                        </a>
                    }

                    @if (Claim.ClaimSourceObservedOn is not null)
                    {
                        <p class="fact-check-card__provenance">
                            @ObservationLabel @(Claim.ClaimSourceObservedOn.Value.ToString("MMMM d, yyyy")).
                            This is an observation date, not an archived-web capture date.
                        </p>
                    }
                </div>
            </div>
        </details>
    </article>
</li>

@code {
    [Parameter, EditorRequired]
    public FactCheckClaim Claim { get; set; } = default!;

    private IEnumerable<string> DetailParagraphs => Claim.DetailedExplanation.Split(
        new[] { "\r\n\r\n", "\n\n" },
        StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string? ClaimantSourceUrl => string.IsNullOrWhiteSpace(Claim.ClaimSourceArchivedUrl)
        ? Claim.ClaimSourceUrl
        : Claim.ClaimSourceArchivedUrl;

    private string ClaimantSourceLabel => string.IsNullOrWhiteSpace(Claim.ClaimSourceArchivedUrl)
        ? "View current claimant page"
        : "View archived claimant source";

    private string ObservationLabel => Claim.ClaimSourceObservationType switch
    {
        "ReportScrape" => "Claimant content was observed by the August 8 research report scrape on",
        "LiveReview" => "Claimant page was independently reviewed on",
        _ => "Claimant content was observed on"
    };
}
