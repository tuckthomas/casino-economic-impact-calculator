@using SaveNEIN.Client.Models

<li class="fact-check-entry" id="fact-check-@Claim.Slug-@IdSuffix">
    <article class="fact-check-entry__card" aria-labelledby="fact-check-title-@Claim.Id-@IdSuffix">
        <div class="fact-check-entry__header">
            <div class="fact-check-entry__heading-copy">
                <span class="fact-check-entry__category">@Claim.Category</span>
                <p class="fact-check-entry__claimant">@(Claim.IsDirectQuote ? $"{Claim.Claimant} claim" : $"{Claim.Claimant} framing")</p>
            </div>
            <div class="fact-check-entry__gauge">
                <FactCheckGauge Verdict="Claim.Verdict" />
            </div>
        </div>

        <h4 class="fact-check-entry__claim" id="fact-check-title-@Claim.Id-@IdSuffix">
            @if (Claim.IsDirectQuote)
            {
                <span>&ldquo;@Claim.ClaimText&rdquo;</span>
            }
            else
            {
                <span>@Claim.ClaimText</span>
            }
        </h4>

        <div class="fact-check-entry__evidence-summary">
            <p class="fact-check-entry__evidence-label">The evidence</p>
            <p>@Claim.ShortFinding</p>
        </div>

        <details class="fact-check-entry__details">
            <summary>View evidence &amp; sources</summary>
            <div class="fact-check-entry__details-body">
                @foreach (var paragraph in DetailParagraphs)
                {
                    <p>@paragraph</p>
                }

                @if (Claim.KeyFacts.Count > 0)
                {
                    <ul class="fact-check-entry__key-facts">
                        @foreach (var fact in Claim.KeyFacts)
                        {
                            <li>@fact</li>
                        }
                    </ul>
                }

                @foreach (var table in Claim.EvidenceTables)
                {
                    <div class="fact-check-entry__table-wrap">
                        <table>
                            <caption>@table.Caption</caption>
                            <thead>
                                <tr>
                                    @foreach (var header in table.Headers)
                                    {
                                        <th scope="col">@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in table.Rows)
                                {
                                    <tr>
                                        @for (var i = 0; i < row.Count; i++)
                                        {
                                            if (i == 0)
                                            {
                                                <th scope="row">@row[i]</th>
                                            }
                                            else
                                            {
                                                <td>@row[i]</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="fact-check-entry__sources">
                    <p class="fact-check-entry__detail-heading">Sources</p>
                    <ul>
                        @foreach (var source in Claim.Sources)
                        {
                            <li>
                                @if (!string.IsNullOrWhiteSpace(source.Url))
                                {
                                    <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Label</a>
                                }
                                else
                                {
                                    <strong>@source.Label</strong>
                                }
                                <span> — @source.Citation</span>
                            </li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(Claim.ClaimSourceUrl))
                    {
                        <a class="fact-check-entry__claim-source" href="@Claim.ClaimSourceUrl" target="_blank" rel="noopener noreferrer">
                            View claimant source
                            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                        </a>
                    }
                </div>
            </div>
        </details>
    </article>
</li>

@code {
    [Parameter, EditorRequired]
    public FactCheckClaim Claim { get; set; } = default!;

    [Parameter]
    public string IdSuffix { get; set; } = "default";

    private IEnumerable<string> DetailParagraphs => Claim.DetailedExplanation.Split(
        new[] { "\r\n\r\n", "\n\n" },
        StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

}
