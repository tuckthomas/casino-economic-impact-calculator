@using SaveNEIN.Client.Models

<li class="fact-check-entry" id="fact-check-@Claim.Slug-@IdSuffix">
    <article class="fact-check-entry__card" aria-labelledby="fact-check-title-@Claim.Id-@IdSuffix">
        <div class="fact-check-entry__card-main">
        <div class="fact-check-entry__header">
            <div class="fact-check-entry__heading-copy">
                <div class="fact-check-entry__tags" aria-label="Fact check tags">
                    @foreach (var impactTag in Claim.ImpactTags)
                    {
                        <span class="fact-check-entry__tag fact-check-entry__tag--impact">@impactTag</span>
                    }
                    <span class="fact-check-entry__tag fact-check-entry__tag--source">@Claim.SourceTag</span>
                </div>
            </div>

            <div class="fact-check-entry__evidence-summary">
                <p class="fact-check-entry__evidence-label">@($"{Claim.SourceTag.ToUpperInvariant()}'S CLAIM:")</p>
                <p class="fact-check-entry__claim-text">
                    @if (Claim.IsDirectQuote)
                    {
                        <span>&ldquo;@Claim.ClaimText&rdquo;</span>
                    }
                    else
                    {
                        <span>@Claim.ClaimText</span>
                    }
                </p>
            </div>

            <div class="fact-check-entry__utility">
                <FactCheckShare Claim="Claim" />
                <div class="fact-check-entry__gauge">
                    <FactCheckGauge Verdict="Claim.Verdict" />
                </div>
            </div>
        </div>

        <section class="fact-check-entry__finding" aria-label="Evidence-backed finding">
            <p class="fact-check-entry__finding-label">Evidence summary:</p>
            <h4 id="fact-check-title-@Claim.Id-@IdSuffix">@Claim.FindingHeadline</h4>
            <p>@Claim.ShortFinding</p>
        </section>

        <details class="fact-check-entry__details">
            <summary>View evidence &amp; sources</summary>
        </details>
        </div>
        <div class="fact-check-entry__details-body">
                @foreach (var paragraph in DetailParagraphs)
                {
                    <p>@paragraph</p>
                }

                @if (Claim.KeyFacts.Count > 0)
                {
                    <ul class="fact-check-entry__key-facts">
                        @foreach (var fact in Claim.KeyFacts)
                        {
                            <li>@fact</li>
                        }
                    </ul>
                }

                @foreach (var table in Claim.EvidenceTables)
                {
                    <div class="fact-check-entry__table-wrap">
                        <table>
                            <caption>@table.Caption</caption>
                            <thead>
                                <tr>
                                    @foreach (var header in table.Headers)
                                    {
                                        <th scope="col">@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in table.Rows)
                                {
                                    <tr>
                                        @for (var i = 0; i < row.Count; i++)
                                        {
                                            if (i == 0)
                                            {
                                                <th scope="row">@row[i]</th>
                                            }
                                            else
                                            {
                                                <td>@row[i]</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="fact-check-entry__sources">
                    <p class="fact-check-entry__detail-heading">Sources</p>
                    <ul>
                        @foreach (var source in Claim.Sources)
                        {
                            <li>
                                @if (!string.IsNullOrWhiteSpace(SourceHref(source)))
                                {
                                    <a href="@SourceHref(source)" target="_blank" rel="noopener noreferrer">@ArchiveLinkText(source)</a>
                                }
                                else
                                {
                                    <strong>@source.Label</strong>
                                }
                                <span> — @source.Citation</span>
                            </li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(Claim.ClaimSourceArchivedUrl) && Claim.ClaimSourceCapturedAtUtc is not null)
                    {
                        <a class="fact-check-entry__claim-source" href="@Claim.ClaimSourceArchivedUrl" target="_blank" rel="noopener noreferrer">
                            View archived claimant source [Archived @Claim.ClaimSourceCapturedAtUtc.Value.ToString("MM/dd/yyyy")]
                            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                        </a>
                    }
                </div>
        </div>
    </article>
</li>

@code {
    [Parameter, EditorRequired]
    public FactCheckClaim Claim { get; set; } = default!;

    [Parameter]
    public string IdSuffix { get; set; } = "default";

    private IEnumerable<string> DetailParagraphs => Claim.DetailedExplanation.Split(
        new[] { "\r\n\r\n", "\n\n" },
        StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // Public fact-check links must always resolve to the immutable capture, never the live source.
    private static string? SourceHref(FactCheckSource source) =>
        source.ArchivedAtUtc is not null && !string.IsNullOrWhiteSpace(source.ArchivedUrl)
            ? source.ArchivedUrl
            : null;

    private static string ArchiveLinkText(FactCheckSource source) => source.ArchivedAtUtc is { } archivedAt
        ? $"{source.Label} [Archived {archivedAt:MM/dd/yyyy}]"
        : source.Label;

}
