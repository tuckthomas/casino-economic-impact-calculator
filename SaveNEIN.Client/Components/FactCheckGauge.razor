@using SaveNEIN.Client.Models

<div class="fact-check-gauge @SizeClass" style="@GaugeStyle" role="img" aria-label="@($"{VerdictLabel} rating")">
    <div class="fact-check-gauge__face">
        <span class="fact-check-gauge__tick fact-check-gauge__tick--one"></span>
        <span class="fact-check-gauge__tick fact-check-gauge__tick--two"></span>
        <span class="fact-check-gauge__tick fact-check-gauge__tick--three"></span>
        <span class="fact-check-gauge__tick fact-check-gauge__tick--four"></span>
        <span class="fact-check-gauge__needle"></span>
        <span class="fact-check-gauge__hub"></span>
        <span class="fact-check-gauge__label @VerdictClass">@VerdictLabel</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public FactCheckVerdict Verdict { get; set; }

    [Parameter]
    public bool Large { get; set; }

    private string SizeClass => Large ? "fact-check-gauge--large" : "fact-check-gauge--timeline";

    private string VerdictLabel => Verdict switch
    {
        FactCheckVerdict.True => "TRUE",
        FactCheckVerdict.MostlyTrue => "MOSTLY TRUE",
        FactCheckVerdict.MostlyFalse => "MOSTLY FALSE",
        FactCheckVerdict.False => "FALSE",
        _ => "UNRATED"
    };

    private string VerdictClass => Verdict switch
    {
        FactCheckVerdict.False => "is-negative",
        FactCheckVerdict.MostlyFalse => "is-negative",
        _ => string.Empty
    };

    private string GaugeStyle => Verdict switch
    {
        FactCheckVerdict.True => "--needle-angle:-30deg;--verdict-color:#22c55e;--verdict-glow:rgba(34,197,94,.46);",
        FactCheckVerdict.MostlyTrue => "--needle-angle:-62deg;--verdict-color:#84cc16;--verdict-glow:rgba(132,204,22,.40);",
        FactCheckVerdict.MostlyFalse => "--needle-angle:-118deg;--verdict-color:#f59e0b;--verdict-glow:rgba(245,158,11,.42);",
        FactCheckVerdict.False => "--needle-angle:192deg;--verdict-color:#dc2626;--verdict-glow:rgba(220,38,38,.45);",
        _ => "--needle-angle:-90deg;--verdict-color:#94a3b8;--verdict-glow:rgba(148,163,184,.35);"
    };
}
