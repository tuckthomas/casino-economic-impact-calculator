@using SaveNEIN.Client.Models

<div class="fact-check-gauge @SizeClass" style="@GaugeStyle" role="img" aria-label="@($"{VerdictLabel} rating")">
    <div class="fact-check-gauge__face">
        <img class="fact-check-gauge__dial" src="/assets/fact-check-gauge-face.png" alt="" aria-hidden="true" />
        <span class="fact-check-gauge__needle"></span>
        <span class="fact-check-gauge__hub"></span>
        <span class="fact-check-gauge__label @VerdictClass">@VerdictLabel</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public FactCheckVerdict Verdict { get; set; }

    [Parameter]
    public bool Large { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    private string SizeClass => Large
        ? "fact-check-gauge--large"
        : Compact
            ? "fact-check-gauge--compact"
            : "fact-check-gauge--timeline";

    private string VerdictLabel => Verdict switch
    {
        FactCheckVerdict.True => "TRUE",
        FactCheckVerdict.MostlyTrue => "MOSTLY TRUE",
        FactCheckVerdict.MostlyFalse => "MOSTLY FALSE",
        FactCheckVerdict.False => "FALSE",
        _ => "UNRATED"
    };

    private string VerdictClass => Verdict switch
    {
        FactCheckVerdict.False => "is-negative",
        FactCheckVerdict.MostlyFalse => "is-negative",
        _ => string.Empty
    };

    private string GaugeStyle => Verdict switch
    {
        FactCheckVerdict.True => "--needle-angle:-20deg;",
        FactCheckVerdict.MostlyTrue => "--needle-angle:-55deg;",
        FactCheckVerdict.MostlyFalse => "--needle-angle:-130deg;",
        FactCheckVerdict.False => "--needle-angle:-170deg;",
        _ => "--needle-angle:-90deg;"
    };
}
