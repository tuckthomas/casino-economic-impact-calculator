@using SaveNEIN.Client.Models
@using SaveNEIN.Client.Services
@inject FactCheckContentService FactCheckContent
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<section class="bg-slate-50 dark:bg-[#0B1221] py-24 relative overflow-hidden [--fc-card:#ffffff] [--fc-card-border:#cbd5e1] [--fc-text:#0f172a] [--fc-muted:#64748b] [--fc-surface:#f8fafc] [--fc-surface-border:#e2e8f0] [--fc-heading:#334155] [--fc-line:#94a3b8] dark:[--fc-card:#0f172a] dark:[--fc-card-border:#334155] dark:[--fc-text:#f8fafc] dark:[--fc-muted:#94a3b8] dark:[--fc-surface:#1e293b] dark:[--fc-surface-border:#334155] dark:[--fc-heading:#e2e8f0] dark:[--fc-line:#475569]" id="casino-fact-checks">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-heading-block mb-16 text-center max-w-3xl mx-auto" id="decoding-the-spin">
            <span class="section-eyebrow text-red-700 dark:text-red-400">
                Save<span class="text-slate-900 dark:text-white">NEIN</span> Research Fact Check
            </span>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl uppercase">
                Casino Proponents <span class="text-red-700 dark:text-red-400">Fact Check</span>
            </h2>
            <p class="section-heading-description mt-4 text-xl italic text-slate-500 dark:text-slate-400 font-medium w-full max-w-none md:max-w-2xl md:mx-auto">
                What the casino campaign says—and what the evidence actually shows.
            </p>
        </div>

        @if (_loadFailed)
        {
            <div class="fact-check-load-error" role="alert">Fact-check content could not be loaded.</div>
        }
        else
        {
            <FactCheckCatalog Claims="FalseFactChecks" IdPrefix="homepage-fact-checks" />

            <div class="mt-12 flex justify-center">
                <AppButton type="button"
                           Icon="arrow_forward"
                           Class="bg-red-700 px-6 py-3 text-base text-white hover:bg-red-800"
                           OnButtonClick="GoToFactChecks">
                    View All Fact Checks
                </AppButton>
            </div>
        }
    </div>
</section>

@code {
    private const int SupportedSchemaVersion = 1;

    private IReadOnlyList<FactCheckClaim> FalseFactChecks = Array.Empty<FactCheckClaim>();
    private bool _loadFailed;
    private bool _layoutInitialized;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var document = FactCheckContent.GetDocument();
            if (document.SchemaVersion != SupportedSchemaVersion)
            {
                _loadFailed = true;
                return;
            }

            var falseClaims = document.FactChecks
                .Where(claim => claim.Verdict == FactCheckVerdict.False)
                .ToArray();

            var homepageIds = document.HomepageFactCheckIds ?? Array.Empty<string>();
            ApplyClaims(homepageIds.Count == 0
                ? falseClaims
                : homepageIds
                    .Select(id => falseClaims.FirstOrDefault(claim => string.Equals(claim.Id, id, StringComparison.Ordinal)))
                    .Where(claim => claim is not null)
                    .Cast<FactCheckClaim>()
                    .ToArray());

            ApplyClaims(await FactCheckContent.AttachVerifiedArchivesAsync(FalseFactChecks));
        }
        catch (System.Text.Json.JsonException) { _loadFailed = true; }
        catch (InvalidOperationException) { _loadFailed = true; }
    }

    private void ApplyClaims(IReadOnlyList<FactCheckClaim> claims)
    {
        FalseFactChecks = claims;
    }

    private void GoToFactChecks() => NavigationManager.NavigateTo("/fact-checks");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loadFailed && !_layoutInitialized)
        {
            _layoutInitialized = true;
            await JSRuntime.InvokeVoidAsync("window.FactCheckLayout.init");
        }
    }
}
