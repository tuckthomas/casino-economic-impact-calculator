@using System.Net.Http.Json
@using SaveNEIN.Client.Models
@inject HttpClient Http

<section class="bg-slate-50 dark:bg-[#0B1221] py-24 relative overflow-hidden [--fc-card:#ffffff] [--fc-card-border:#cbd5e1] [--fc-text:#0f172a] [--fc-muted:#64748b] [--fc-surface:#f8fafc] [--fc-surface-border:#e2e8f0] [--fc-heading:#334155] [--fc-line:#94a3b8] dark:[--fc-card:#0f172a] dark:[--fc-card-border:#334155] dark:[--fc-text:#f8fafc] dark:[--fc-muted:#94a3b8] dark:[--fc-surface:#1e293b] dark:[--fc-surface-border:#334155] dark:[--fc-heading:#e2e8f0] dark:[--fc-line:#475569]" id="proponents-critique">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-heading-block mb-16 text-center max-w-3xl mx-auto" id="decoding-the-spin">
            <span class="section-eyebrow text-red-700 dark:text-red-400">
                Save<span class="text-slate-900 dark:text-white">NE</span>IN Research Fact Check
            </span>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl uppercase">
                Casino Proponents <span class="text-red-700 dark:text-red-400">Fact Check</span>
            </h2>
            <p class="section-heading-description mt-4 text-xl italic text-slate-500 dark:text-slate-400 font-medium w-full max-w-none md:max-w-2xl md:mx-auto">
                What the casino campaign says—and what the evidence actually shows.
            </p>
        </div>

        @if (!_loaded)
        {
            <div class="fact-check-loading" role="status">Loading fact checks…</div>
        }
        else if (_loadFailed)
        {
            <div class="fact-check-load-error" role="alert">
                Fact-check content could not be loaded.
            </div>
        }
        else if (_factChecks.Count == 0)
        {
            <div class="fact-check-loading">No fact checks are configured for this deployment.</div>
        }
        else
        {
            <ol class="fact-check-timeline" aria-label="Casino proponents fact checks">
                @for (var i = 0; i < _factChecks.Count; i++)
                {
                    var claim = _factChecks[i];
                    <FactCheckCard @key="claim.Id" Claim="claim" IsRight="@(i % 2 == 1)" />
                }
            </ol>
        }
    </div>
</section>

@code {
    private const int SupportedSchemaVersion = 1;

    private IReadOnlyList<FactCheckClaim> _factChecks = Array.Empty<FactCheckClaim>();
    private bool _loaded;
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var document = await Http.GetFromJsonAsync<FactCheckDocument>("data/fact-checks.json");
            if (document is null || document.SchemaVersion != SupportedSchemaVersion)
            {
                _loadFailed = true;
                return;
            }

            _factChecks = document.FactChecks ?? Array.Empty<FactCheckClaim>();
        }
        catch (HttpRequestException)
        {
            _loadFailed = true;
        }
        catch (NotSupportedException)
        {
            _loadFailed = true;
        }
        catch (System.Text.Json.JsonException)
        {
            _loadFailed = true;
        }
        finally
        {
            _loaded = true;
        }
    }
}
