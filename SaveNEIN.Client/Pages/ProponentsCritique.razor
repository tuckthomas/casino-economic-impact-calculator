@using SaveNEIN.Client.Models

<section class="bg-slate-50 dark:bg-[#0B1221] py-24 relative overflow-hidden [--fc-card:#ffffff] [--fc-card-border:#cbd5e1] [--fc-text:#0f172a] [--fc-muted:#64748b] [--fc-surface:#f8fafc] [--fc-surface-border:#e2e8f0] [--fc-heading:#334155] [--fc-line:#94a3b8] dark:[--fc-card:#0f172a] dark:[--fc-card-border:#334155] dark:[--fc-text:#f8fafc] dark:[--fc-muted:#94a3b8] dark:[--fc-surface:#1e293b] dark:[--fc-surface-border:#334155] dark:[--fc-heading:#e2e8f0] dark:[--fc-line:#475569]" id="proponents-critique">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-heading-block mb-10 text-center max-w-4xl mx-auto" id="decoding-the-spin">
            <p class="text-sm font-black uppercase tracking-[0.16em] text-red-700 dark:text-red-400 mb-3">SaveNEIN Research Fact Check</p>
            <h3 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tight mb-4">
                Casino Proponents <span class="text-red-700 dark:text-red-400">Fact Check</span>
            </h3>
            <p class="section-heading-description mt-4 text-lg md:text-xl text-slate-600 dark:text-slate-300 font-medium w-full max-w-3xl mx-auto">
                Public casino claims checked against the studies, statutes, government guidance, and empirical evidence behind them.
                The rating evaluates the claim as stated, including its geography, definition, timeframe, and level of certainty.
            </p>
        </div>

        <details class="fact-check-methodology mx-auto mb-14 max-w-5xl rounded-2xl border border-slate-200 bg-white/90 p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
            <summary class="cursor-pointer text-base font-black uppercase tracking-wide text-slate-900 dark:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-600">
                How the ratings work
            </summary>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-900 dark:bg-emerald-950/30">
                    <p class="text-sm font-black uppercase tracking-wide text-emerald-800 dark:text-emerald-300">True</p>
                    <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">Supported by the best available evidence without a material omitted qualification.</p>
                </div>
                <div class="rounded-xl border border-lime-200 bg-lime-50 p-4 dark:border-lime-900 dark:bg-lime-950/30">
                    <p class="text-sm font-black uppercase tracking-wide text-lime-800 dark:text-lime-300">Mostly True</p>
                    <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">The central assertion is supported, but important context, scope, or precision is missing.</p>
                </div>
                <div class="rounded-xl border border-orange-200 bg-orange-50 p-4 dark:border-orange-900 dark:bg-orange-950/30">
                    <p class="text-sm font-black uppercase tracking-wide text-orange-800 dark:text-orange-300">Mostly False</p>
                    <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">A factual kernel exists, but the wording materially changes the geography, definition, magnitude, certainty, or implication.</p>
                </div>
                <div class="rounded-xl border border-red-200 bg-red-50 p-4 dark:border-red-900 dark:bg-red-950/30">
                    <p class="text-sm font-black uppercase tracking-wide text-red-800 dark:text-red-300">False</p>
                    <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">The assertion is contradicted by the evidence or lacks an adequate factual basis as stated.</p>
                </div>
            </div>
            <p class="mt-5 text-sm leading-6 text-slate-600 dark:text-slate-400">
                Secondary tags identify the type of problem, such as <strong>Projection</strong>, <strong>Unsupported</strong>,
                <strong>Outdated</strong>, <strong>Geography Error</strong>, <strong>Definition Error</strong>, <strong>Missing Context</strong>,
                <strong>Policy Promise</strong>, or <strong>Unproven Causation</strong>. A projection is not rated false merely because it is a projection.
            </p>
        </details>

        <ol class="fact-check-timeline" aria-label="Casino proponents fact checks">
            @for (var i = 0; i < FactChecks.Count; i++)
            {
                var claim = FactChecks[i];
                <FactCheckTimelineItem @key="claim.Id" Claim="claim" IsRight="@(i % 2 == 1)" />
            }
        </ol>

        <div class="mt-14 mx-auto max-w-4xl rounded-2xl border border-slate-200 bg-white/80 p-6 text-center dark:border-slate-700 dark:bg-slate-900/60">
            <h4 class="text-xl font-black text-slate-900 dark:text-white">Source-first, not slogan-first</h4>
            <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">
                These ratings are intentionally conservative. Commissioned research is not rejected because it was commissioned, and model output is not rejected because it is modeled.
                The question is whether the public claim accurately describes what the cited evidence actually establishes.
            </p>
        </div>
    </div>
</section>

