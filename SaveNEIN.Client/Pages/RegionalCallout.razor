@inject IJSRuntime JSRuntime

<section class="regional-callout w-full relative shadow-2xl flex flex-col justify-center overflow-hidden">
    <img src="assets/depressing_downtown.png"
         alt="Downtown Northeast Indiana"
         class="regional-callout-image absolute inset-0 w-full h-full object-cover z-0"
         loading="lazy" />
    <div class="relative w-full flex flex-col justify-center pl-4 pr-4 sm:pl-12 sm:pr-0 lg:pl-16 z-20 pointer-events-none">
        <h2 class="regional-callout-title font-black text-white drop-shadow-lg">
            <span class="regional-callout-word block opacity-0 translate-y-8 transition-all duration-700 ease-out scroll-reveal">NORTHEAST</span>
            <span class="regional-callout-word block opacity-0 translate-y-8 transition-all duration-700 ease-out scroll-reveal" style="transition-delay: 350ms;">INDIANA</span>
            <span class="regional-callout-word block opacity-0 translate-y-8 transition-all duration-700 ease-out scroll-reveal text-orange-500" style="transition-delay: 700ms;">DESERVES</span>
            <span class="regional-callout-word block opacity-0 translate-y-8 transition-all duration-700 ease-out scroll-reveal" style="transition-delay: 1050ms;">BETTER</span>
        </h2>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.initScrollReveal");
        }
    }
}
