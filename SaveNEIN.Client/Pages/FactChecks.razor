@page "/fact-checks"
@page "/fact-checks/{Slug}"
@using SaveNEIN.Client.Models
@using SaveNEIN.Client.Services
@inject FactCheckContentService FactCheckContent
@inject IJSRuntime JSRuntime

<PageTitle>Fact Checks | Save Northeast Indiana</PageTitle>

<section class="min-h-screen bg-slate-50 py-24 dark:bg-[#0B1221] [--fc-card:#ffffff] [--fc-card-border:#cbd5e1] [--fc-text:#0f172a] [--fc-muted:#64748b] [--fc-surface:#f8fafc] [--fc-surface-border:#e2e8f0] [--fc-heading:#334155] [--fc-line:#94a3b8] dark:[--fc-card:#0f172a] dark:[--fc-card-border:#334155] dark:[--fc-text:#f8fafc] dark:[--fc-muted:#94a3b8] dark:[--fc-surface:#1e293b] dark:[--fc-surface-border:#334155] dark:[--fc-heading:#e2e8f0] dark:[--fc-line:#475569]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-heading-block mb-16 max-w-3xl text-center mx-auto">
            <span class="section-eyebrow text-red-700 dark:text-red-400">Save<span class="text-slate-900 dark:text-white">NE</span>IN Research Fact Check</span>
            <h1 class="mt-2 text-3xl font-black uppercase tracking-tight text-slate-900 dark:text-white sm:text-4xl">All <span class="text-red-700 dark:text-red-400">Fact Checks</span></h1>
            <p class="section-heading-description mt-4 text-xl italic font-medium text-slate-500 dark:text-slate-400">Campaign claims and the evidence used to evaluate them.</p>
        </div>

        @if (_loadFailed)
        {
            <div class="fact-check-load-error" role="alert">Fact-check content could not be loaded.</div>
        }
        else
        {
            <FactCheckCatalog Claims="AllFactChecks" IdPrefix="all-fact-checks" />
        }
    </div>
</section>

@code {
    private const int SupportedSchemaVersion = 2;
    [Parameter] public string? Slug { get; set; }
    private IReadOnlyList<FactCheckClaim> AllFactChecks = Array.Empty<FactCheckClaim>();
    private bool _loadFailed;
    private bool _layoutInitialized;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var document = FactCheckContent.GetDocument();
            if (document.SchemaVersion != SupportedSchemaVersion)
            {
                _loadFailed = true;
                return;
            }

            AllFactChecks = document.FactChecks;
            AllFactChecks = await FactCheckContent.AttachVerifiedArchivesAsync(AllFactChecks);
        }
        catch (System.Text.Json.JsonException) { _loadFailed = true; }
        catch (InvalidOperationException) { _loadFailed = true; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loadFailed && !_layoutInitialized)
        {
            _layoutInitialized = true;
            await JSRuntime.InvokeVoidAsync("window.FactCheckLayout.init");
        }

        if (firstRender && !_loadFailed && !string.IsNullOrWhiteSpace(Slug))
        {
            await JSRuntime.InvokeVoidAsync("window.FactCheckLayout.scrollToClaim", Slug);
        }
    }
}
