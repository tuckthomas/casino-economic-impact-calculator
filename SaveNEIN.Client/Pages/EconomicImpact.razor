@inject HttpClient Http
@using System.Globalization

<section class="model-workbench" id="economic-analysis" aria-labelledby="model-workbench-title">
    <div class="model-workbench-shell">
        <header class="model-workbench-heading">
            <span class="model-eyebrow">Canonical economic model</span>
            <h2 id="model-workbench-title">Stored-run casino impact workbench</h2>
            <p>
                Configure a versioned scenario, run the server-side gravity model, and compare immutable results.
                Revenue is calculated from origin demand and Valhalla drive times—there is no browser-side AGR multiplier.
            </p>
        </header>

        @if (_loading)
        {
            <div class="model-status" role="status">Loading model catalog and sealed data snapshots…</div>
        }
        else if (_configuration is null)
        {
            <div class="model-alert model-alert-error" role="alert">
                <strong>Model configuration unavailable.</strong>
                <span>@(_error ?? "The server did not return a model catalog.")</span>
                <button type="button" @onclick="LoadAsync">Retry</button>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="model-alert model-alert-error" role="alert">
                    <strong>Scenario could not run.</strong>
                    <span>@_error</span>
                </div>
            }

            <div class="model-workbench-grid">
                <aside class="model-panel model-input-panel" aria-label="Scenario inputs">
                    <div class="model-panel-heading">
                        <div>
                            <span class="model-step">1</span>
                            <h3>Scenario definition</h3>
                        </div>
                        <span class="model-version">@_configuration.ModelVersion</span>
                    </div>

                    <div class="model-form-grid">
                        <label class="model-field model-field-wide">
                            <span>Scenario name</span>
                            <input @bind="_form.ScenarioName" maxlength="120" />
                        </label>

                        <label class="model-field">
                            <span>Host jurisdiction</span>
                            <select @bind="_form.JurisdictionCode" @bind:after="OnJurisdictionChangedAsync">
                                <option value="">Select jurisdiction</option>
                                @foreach (var jurisdiction in _configuration.Jurisdictions.Where(item => item.Kind != "federal"))
                                {
                                    <option value="@jurisdiction.Code">@jurisdiction.Name (@jurisdiction.Code)</option>
                                }
                            </select>
                        </label>

                        <label class="model-field">
                            <span>Development program</span>
                            <select @bind="_form.DevelopmentProgramId">
                                <option value="">Select program</option>
                                @foreach (var program in _configuration.DevelopmentPrograms)
                                {
                                    <option value="@program.Id">@program.Name · v@program.Version</option>
                                }
                            </select>
                        </label>

                        <label class="model-field">
                            <span>Candidate latitude</span>
                            <input type="number" min="-90" max="90" step="0.000001" @bind="_form.CandidateLatitude" />
                        </label>

                        <label class="model-field">
                            <span>Candidate longitude</span>
                            <input type="number" min="-180" max="180" step="0.000001" @bind="_form.CandidateLongitude" />
                        </label>
                    </div>

                    <div class="model-subsection">
                        <div class="model-subsection-heading">
                            <div>
                                <span class="model-step">2</span>
                                <h3>Immutable data inputs</h3>
                            </div>
                            <span class="model-count">@_origins.Count origins</span>
                        </div>

                        <div class="model-form-grid">
                            <label class="model-field">
                                <span>Origin geography</span>
                                <select @bind="_form.OriginGeographySnapshotId" @bind:after="LoadOriginsAsync">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("origin-geography"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Age population</span>
                                <select @bind="_form.AgePopulationSnapshotId">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("age-population"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Income / AGI</span>
                                <select @bind="_form.IncomeSnapshotId">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("income"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Casino competitors</span>
                                <select @bind="_form.CompetitorSnapshotId">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("competitors"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Observed performance</span>
                                <select @bind="_form.ObservedPerformanceSnapshotId" @bind:after="ApplySnapshotYears">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("observed-performance"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Tourism (optional)</span>
                                <select @bind="_form.TourismSnapshotId" @bind:after="LoadTourismAsync">
                                    <option value="">No tourism snapshot</option>
                                    @foreach (var snapshot in Snapshots("tourism"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Traffic (optional)</span>
                                <select @bind="_form.TrafficSnapshotId" @bind:after="LoadTrafficAsync">
                                    <option value="">No traffic snapshot</option>
                                    @foreach (var snapshot in Snapshots("traffic"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Local sector inventory (optional)</span>
                                <select @bind="_form.LocalEconomicInventorySnapshotId">
                                    <option value="">Use parameterized sector priors</option>
                                    @foreach (var snapshot in Snapshots("local-economic-inventory"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Origin state/territory code</span>
                                <input @bind="_form.OriginStateCode" @bind:after="LoadOriginsAsync" maxlength="10" />
                            </label>
                        </div>

                        <div class="model-data-summary">
                            <span><strong>@_origins.Count</strong> ZCTA/flexible origins selected</span>
                            <span><strong>@_tourism.Count</strong> tourism observations selected</span>
                            <span><strong>@_traffic.Count</strong> traffic corridors selected</span>
                        </div>
                    </div>

                    <div class="model-subsection">
                        <div class="model-subsection-heading">
                            <div>
                                <span class="model-step">3</span>
                                <h3>Model assumptions</h3>
                            </div>
                            <button class="model-link-button" type="button" @onclick="ToggleAdvanced">
                                @(_showAdvanced ? "Hide advanced" : "Show advanced")
                            </button>
                        </div>

                        <div class="model-form-grid">
                            <label class="model-field">
                                <span>Scenario preset</span>
                                <select @bind="_form.ScenarioParameterSetId">
                                    <option value="">System/base values</option>
                                    @foreach (var set in _configuration.ParameterSets.Where(set => set.Scope == "scenario"))
                                    {
                                        <option value="@set.Id">@set.Name · @set.Version</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Demand specification</span>
                                <select @bind="_form.DemandSpecification">
                                    <option value="agi-share">AGI-share demand</option>
                                    <option value="eligible-adult-per-capita">Eligible-adult per capita</option>
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Facility attraction</span>
                                <select @bind="_form.AttractionSpecification">
                                    <option value="observed-ggr">Observed-GGR mass</option>
                                    <option value="structural">Structural facility mass</option>
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Travel-friction form</span>
                                <select @bind="_form.FrictionForm">
                                    <option value="inverse-power">Inverse power (beta)</option>
                                    <option value="exponential">Exponential decay</option>
                                </select>
                            </label>
                        </div>

                        <div class="model-parameter-grid">
                            @foreach (var definition in StandardDefinitions())
                            {
                                @ParameterEditor(definition)
                            }
                        </div>

                        @if (_showAdvanced)
                        {
                            <div class="model-advanced" aria-label="Advanced model parameters">
                                <div class="model-advanced-toolbar">
                                    <label class="model-field">
                                        <span>Filter parameters</span>
                                        <input @bind="_parameterSearch" placeholder="beta, social cost, traffic…" />
                                    </label>
                                    <button type="button" class="model-secondary-button" @onclick="ResetOverrides">Reset all overrides</button>
                                </div>
                                <div class="model-parameter-grid">
                                    @foreach (var definition in AdvancedDefinitions())
                                    {
                                        @ParameterEditor(definition)
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="model-run-actions">
                        <button class="model-primary-button" type="button" disabled="@(!CanRun || _running)" @onclick="RunScenarioAsync">
                            @(_running ? "Running Valhalla + impact pipeline…" : "Run and store scenario")
                        </button>
                        <span>@RunReadiness</span>
                    </div>
                </aside>

                <main class="model-results" aria-live="polite">
                    <div class="model-panel-heading model-results-heading">
                        <div>
                            <span class="model-step">4</span>
                            <h3>Stored-run results</h3>
                        </div>
                        @if (_latestRun is not null)
                        {
                            <span class="model-run-id">@_latestRun.ModelRunId</span>
                        }
                    </div>

                    @if (_latestRun is null)
                    {
                        <div class="model-empty-state">
                            <span class="material-symbols-outlined" aria-hidden="true">database</span>
                            <h3>No scenario run in this session</h3>
                            <p>Complete the required data selections and run the authoritative backend model.</p>
                        </div>
                    }
                    else
                    {
                        <section class="model-result-hero">
                            <span>Stabilized annual GGR</span>
                            <strong>@Money(_latestRun.StabilizedTotalGgr)</strong>
                            <p>@_latestRun.Status · @_latestRun.ComputationalOriginType.ToUpperInvariant() origins · @_latestRun.RoutingGraphHash[..Math.Min(12, _latestRun.RoutingGraphHash.Length)] routing graph</p>
                        </section>

                        <div class="model-metric-grid">
                            @Metric("Resident GGR", Money(_latestRun.ProposedResidentGgr))
                            @Metric("Tourism GGR", Money(_latestRun.TourismGgr))
                            @Metric("Traffic GGR", Money(_latestRun.TrafficGgr))
                            @Metric("Local displacement", Money(_latestRun.LocalDiscretionaryDisplacement), "negative")
                            @Metric("Gross gaming tax", Money(_latestRun.GrossGamingTax))
                            @Metric("Gross social cost", Money(_latestRun.GrossSocialCost), "negative")
                            @Metric("Net permanent jobs", Number(_latestRun.NetPermanentJobs), Tone(_latestRun.NetPermanentJobs))
                            @Metric("Net host-local impact", Money(_latestRun.NetHostLocalImpact), Tone(_latestRun.NetHostLocalImpact))
                            @Metric("Net host-state impact", Money(_latestRun.NetHostStateImpact), Tone(_latestRun.NetHostStateImpact))
                        </div>

                        <section class="model-decomposition">
                            <h4>Revenue source decomposition</h4>
                            @foreach (var source in _latestRun.ProposedCaptureBySource.OrderByDescending(item => item.Value))
                            {
                                <div class="model-bridge-row">
                                    <span>@Humanize(source.Key)</span>
                                    <strong>@Money(source.Value)</strong>
                                </div>
                            }
                        </section>

                        @if (_latestRun.Warnings.Count > 0)
                        {
                            <details class="model-warning-list">
                                <summary>@_latestRun.Warnings.Count model warning(s)</summary>
                                <ul>
                                    @foreach (var warning in _latestRun.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </details>
                        }

                        <section class="model-report-actions" aria-label="Full analytical report">
                            <div>
                                <h4>Full stored-run report</h4>
                                <p>Generate PDF, accessible HTML, JSON, and CSV from this finalized run without recalculating the model.</p>
                            </div>
                            <button type="button" class="model-primary-button" disabled="@_generatingReport" @onclick="GenerateReportAsync">
                                @(_generatingReport ? "Rendering server report…" : "Generate full report")
                            </button>
                            @if (_reportArtifact is not null)
                            {
                                <nav class="model-report-downloads" aria-label="Report downloads">
                                    <a href="@_reportArtifact.PdfUrl" target="_blank" rel="noopener">PDF</a>
                                    <a href="@_reportArtifact.HtmlUrl" target="_blank" rel="noopener">HTML</a>
                                    <a href="@_reportArtifact.JsonUrl" target="_blank" rel="noopener">JSON</a>
                                    <a href="@_reportArtifact.CsvUrl">CSV</a>
                                </nav>
                            }
                        </section>

                        <section class="model-sensitivity" aria-labelledby="model-sensitivity-title">
                            <div class="model-subsection-heading">
                                <div>
                                    <span class="model-step">5</span>
                                    <h3 id="model-sensitivity-title">Server-run sensitivity</h3>
                                </div>
                                <span class="model-count">@SelectedSensitivityRunCount full runs</span>
                            </div>
                            <p class="model-muted">
                                Each low and high point reruns Valhalla, gravity allocation, and the complete impact pipeline. No final-output multiplier is used.
                            </p>

                            <label class="model-field model-sensitivity-metric">
                                <span>Tornado output metric</span>
                                <select @bind="_sensitivityMetric">
                                    <option value="stabilized-total-ggr">Stabilized total GGR</option>
                                    <option value="gross-gaming-tax">Gross gaming tax</option>
                                    <option value="gross-social-cost">Gross social cost</option>
                                    <option value="local-discretionary-displacement">Local discretionary displacement</option>
                                    <option value="net-permanent-jobs">Net permanent jobs</option>
                                    <option value="net-host-local-impact">Net host-local impact</option>
                                    <option value="net-host-state-impact">Net host-state impact</option>
                                </select>
                            </label>

                            <div class="model-sensitivity-ranges">
                                @foreach (var range in _sensitivityRanges)
                                {
                                    <div class="model-sensitivity-range">
                                        <label class="model-sensitivity-toggle">
                                            <input type="checkbox" @bind="range.Selected" />
                                            <span>
                                                <strong>@range.DisplayName</strong>
                                                <small>@range.ParameterKey · baseline @range.BaseValue.ToString("G6", CultureInfo.InvariantCulture) @range.Units</small>
                                            </span>
                                        </label>
                                        <label>
                                            <span>Low</span>
                                            <input type="number" step="@range.Step" @bind="range.LowValue" aria-label="Low value for @range.DisplayName" />
                                        </label>
                                        <label>
                                            <span>High</span>
                                            <input type="number" step="@range.Step" @bind="range.HighValue" aria-label="High value for @range.DisplayName" />
                                        </label>
                                    </div>
                                }
                            </div>

                            <button type="button" class="model-secondary-button model-sensitivity-run" disabled="@(!CanRunSensitivity || _runningSensitivity)" @onclick="RunSensitivityAsync">
                                @(_runningSensitivity ? $"Running {SelectedSensitivityRunCount} complete models…" : "Run and store sensitivity")
                            </button>

                            @if (_sensitivityResult is not null)
                            {
                                <div class="model-sensitivity-table-shell">
                                    <table class="model-sensitivity-table">
                                        <caption>
                                            Tornado table · @_sensitivityResult.OutputMetric · analysis @_sensitivityResult.SensitivityAnalysisId
                                        </caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Parameter</th>
                                                <th scope="col">Low result</th>
                                                <th scope="col">Baseline</th>
                                                <th scope="col">High result</th>
                                                <th scope="col">Full range</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in _sensitivityResult.Tornado)
                                            {
                                                <tr>
                                                    <th scope="row">@Humanize(row.ParameterKey)</th>
                                                    <td>@SensitivityValue(row.LowMetricValue)<small>@SignedSensitivityDelta(row.LowDelta)</small></td>
                                                    <td>@SensitivityValue(row.BaseMetricValue)</td>
                                                    <td>@SensitivityValue(row.HighMetricValue)<small>@SignedSensitivityDelta(row.HighDelta)</small></td>
                                                    <td>@SensitivityValue(row.TotalRange)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <button type="button" class="model-secondary-button model-sensitivity-run" disabled="@_generatingReport" @onclick="GenerateSensitivityReportAsync">
                                    @(_generatingReport ? "Rendering sensitivity report…" : "Generate report with sensitivity exhibit")
                                </button>
                            }
                        </section>
                    }

                    <section class="model-comparison" id="economic-analysis-part-2">
                        <div class="model-subsection-heading">
                            <div>
                                <span class="model-step">6</span>
                                <h3>Immutable scenario comparison</h3>
                            </div>
                            <button type="button" class="model-secondary-button" disabled="@(_comparisonSelection.Count < 2 || _comparing)" @onclick="CompareAsync">
                                @(_comparing ? "Loading…" : "Compare selected")
                            </button>
                        </div>

                        @if (_recentRuns.Count == 0)
                        {
                            <p class="model-muted">No stored runs are available yet.</p>
                        }
                        else
                        {
                            <div class="model-run-list">
                                @foreach (var run in _recentRuns)
                                {
                                    <label>
                                        <input type="checkbox" checked="@_comparisonSelection.Contains(run.Id)" @onchange="args => ToggleComparison(run.Id, args)" />
                                        <span>
                                            <strong>@run.ScenarioName</strong>
                                            <small>@run.CreatedAtUtc.ToLocalTime().ToString("g") · @run.Status</small>
                                        </span>
                                    </label>
                                }
                            </div>
                        }

                        @if (_comparison.Count >= 2)
                        {
                            <div class="model-comparison-table-shell">
                                <table class="model-comparison-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Metric</th>
                                            @foreach (var run in _comparison)
                                            {
                                                <th scope="col">@run.ScenarioName</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @ComparisonRow("Stabilized GGR", run => Money(run.StabilizedTotalGgr))
                                        @ComparisonRow("Resident GGR", run => Money(run.TotalWithProjectResidentGgr))
                                        @ComparisonRow("Tourism GGR", run => Money(run.TourismGgr))
                                        @ComparisonRow("Traffic GGR", run => Money(run.TrafficGgr))
                                        @ComparisonRow("Local displacement", run => Money(run.LocalDiscretionaryDisplacement))
                                        @ComparisonRow("Gross gaming tax", run => Money(run.GrossGamingTax))
                                        @ComparisonRow("Gross social cost", run => Money(run.GrossSocialCost))
                                        @ComparisonRow("Net permanent jobs", run => Number(run.NetPermanentJobs))
                                        @ComparisonRow("Net host-local impact", run => Money(run.NetHostLocalImpact))
                                        @ComparisonRow("Net host-state impact", run => Money(run.NetHostStateImpact))
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                </main>
            </div>
        }
    </div>
</section>

@code {
    private static readonly string[] StandardParameterKeys =
    [
        "gravity.beta",
        "gravity.alpha",
        "demand.regional_intensity_multiplier",
        "market_expansion.accessibility_elasticity",
        "tourism.capture_rate",
        "traffic.intercept_rate",
        "displacement.eligible_base_share",
        "displacement.coefficient",
        "social_cost.prevalence",
        "ramp.first_year_share",
        "ramp.second_year_share"
    ];
    private static readonly string[] SensitivityParameterKeys =
    [
        "gravity.beta",
        "gravity.alpha",
        "demand.regional_intensity_multiplier",
        "tourism.capture_rate",
        "traffic.intercept_rate",
        "displacement.eligible_base_share",
        "displacement.coefficient",
        "social_cost.prevalence"
    ];
    private static readonly string[] DefaultSensitivityParameterKeys =
    [
        "gravity.beta",
        "demand.regional_intensity_multiplier",
        "displacement.coefficient",
        "social_cost.prevalence"
    ];

    private ModelConfiguration? _configuration;
    private readonly ScenarioForm _form = new();
    private readonly Dictionary<string, double> _overrides = new(StringComparer.Ordinal);
    private readonly List<OriginOption> _origins = [];
    private readonly List<TourismObservation> _tourism = [];
    private readonly List<TrafficObservation> _traffic = [];
    private readonly List<RecentRun> _recentRuns = [];
    private readonly HashSet<Guid> _comparisonSelection = [];
    private readonly List<ComparisonRun> _comparison = [];
    private readonly List<SensitivityRangeForm> _sensitivityRanges = [];
    private RunResult? _latestRun;
    private RunRequest? _lastRunRequest;
    private bool _loading = true;
    private bool _running;
    private bool _showAdvanced;
    private bool _comparing;
    private bool _generatingReport;
    private bool _runningSensitivity;
    private string? _error;
    private string _parameterSearch = string.Empty;
    private ReportArtifact? _reportArtifact;
    private SensitivityAnalysisResult? _sensitivityResult;
    private string _sensitivityMetric = "net-host-local-impact";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _configuration = await Http.GetFromJsonAsync<ModelConfiguration>("api/gravity-model-configuration");
            if (_configuration is null)
            {
                throw new InvalidOperationException("The model catalog response was empty.");
            }
            ApplyCatalogDefaults();
            await LoadOriginsAsync();
            await LoadTourismAsync();
            await LoadTrafficAsync();
            await LoadRecentRunsAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _configuration = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyCatalogDefaults()
    {
        if (_configuration is null)
        {
            return;
        }
        var jurisdiction = _configuration.Jurisdictions.FirstOrDefault(item => item.Kind == "state")
                           ?? _configuration.Jurisdictions.FirstOrDefault(item => item.Kind != "federal");
        _form.JurisdictionCode = jurisdiction?.Code ?? string.Empty;
        _form.OriginStateCode = StateCode(_form.JurisdictionCode);
        _form.DevelopmentProgramId = _configuration.DevelopmentPrograms.FirstOrDefault()?.Id;
        _form.OriginGeographySnapshotId = LatestSnapshotId("origin-geography");
        _form.AgePopulationSnapshotId = LatestSnapshotId("age-population");
        _form.IncomeSnapshotId = LatestSnapshotId("income");
        _form.CompetitorSnapshotId = LatestSnapshotId("competitors");
        _form.ObservedPerformanceSnapshotId = LatestSnapshotId("observed-performance");
        _form.TourismSnapshotId = LatestSnapshotId("tourism");
        _form.TrafficSnapshotId = LatestSnapshotId("traffic");
        _form.NationalParameterSetId = _configuration.ParameterSets.FirstOrDefault(set => set.Scope == "national")?.Id;
        ApplyJurisdictionParameterSet();
        _form.ScenarioParameterSetId = _configuration.ParameterSets.FirstOrDefault(set => set.ScenarioKind == "base")?.Id;
        ApplySnapshotYears();
    }

    private async Task OnJurisdictionChangedAsync()
    {
        _form.OriginStateCode = StateCode(_form.JurisdictionCode);
        ApplyJurisdictionParameterSet();
        await LoadOriginsAsync();
    }

    private void ApplyJurisdictionParameterSet()
    {
        if (_configuration is null)
        {
            return;
        }
        var jurisdiction = _configuration.Jurisdictions.FirstOrDefault(item => item.Code == _form.JurisdictionCode);
        _form.JurisdictionParameterSetId = _configuration.ParameterSets
            .FirstOrDefault(set => set.Scope == "jurisdiction" && set.JurisdictionId == jurisdiction?.Id)?.Id;
    }

    private async Task LoadOriginsAsync()
    {
        _origins.Clear();
        if (_form.OriginGeographySnapshotId is not { } snapshotId)
        {
            return;
        }
        var url = $"api/gravity-model-configuration/origins?datasetSnapshotId={snapshotId}&take=10000";
        if (!string.IsNullOrWhiteSpace(_form.OriginStateCode))
        {
            url += $"&stateCode={Uri.EscapeDataString(_form.OriginStateCode.Trim().ToUpperInvariant())}";
        }
        var response = await Http.GetFromJsonAsync<OriginResponse>(url);
        if (response is not null)
        {
            _origins.AddRange(response.Origins);
        }
    }

    private async Task LoadTourismAsync()
    {
        _tourism.Clear();
        if (_form.TourismSnapshotId is not { } snapshotId)
        {
            return;
        }
