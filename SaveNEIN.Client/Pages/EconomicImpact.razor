    private bool CanRun =>
        !string.IsNullOrWhiteSpace(_form.ScenarioName) &&
        !string.IsNullOrWhiteSpace(_form.JurisdictionCode) &&
        _form.DevelopmentProgramId.HasValue &&
        _form.CandidateLatitude is >= -90 and <= 90 &&
        _form.CandidateLongitude is >= -180 and <= 180 &&
        _form.OriginGeographySnapshotId.HasValue &&
        _form.AgePopulationSnapshotId.HasValue &&
        _form.IncomeSnapshotId.HasValue &&
        _form.CompetitorSnapshotId.HasValue &&
        _form.ObservedPerformanceSnapshotId.HasValue &&
        _origins.Count > 0;

    private bool CanCreateProgram =>
        !string.IsNullOrWhiteSpace(_programForm.Name) &&
        _programForm.SlotOrVltPositions is >= 0 &&
        _programForm.TableGameCount is >= 0 &&
        (_programForm.SlotOrVltPositions > 0 || _programForm.TableGameCount > 0) &&
        (_programForm.PokerTableCount ?? 0) >= 0 &&
        (_programForm.HotelRoomCount ?? 0) >= 0 &&
        (_programForm.GamingFloorSquareFeet ?? 0) >= 0 &&
        (_programForm.FoodBeverageVenueCount ?? 0) >= 0 &&
        (_programForm.EventCapacity ?? 0) >= 0 &&
        (_programForm.ResortAmenityCount ?? 0) >= 0 &&
        _programForm.CapitalCost is null or >= 0 &&
        _programForm.CapitalCostDollarYear is null or (>= 1900 and <= 2200) &&
        _programForm.StabilizedYearNumber is >= 1 and <= 20;

    private bool CanRunSensitivity =>
        _latestRun is not null && _lastRunRequest is not null &&
        _sensitivityRanges.Any(range => range.Selected) &&
        _sensitivityRanges.Where(range => range.Selected).All(range =>
            double.IsFinite(range.LowValue) && double.IsFinite(range.HighValue) &&
            range.LowValue < range.HighValue && range.LowValue <= range.BaseValue && range.BaseValue <= range.HighValue);

    private int SelectedSensitivityRunCount => 1 + 2 * _sensitivityRanges.Count(range => range.Selected);

    private string RunReadiness => CanRun
        ? "Ready to calculate your estimate."
        : "Select required snapshots, a program, valid coordinates, and at least one origin.";

    private static string Money(decimal? value) => value.HasValue ? value.Value.ToString("C0", CultureInfo.CurrentCulture) : "—";
    private static string Number(double? value) => value.HasValue ? value.Value.ToString("N1", CultureInfo.CurrentCulture) : "—";
    private static string Tone(decimal value) => value >= 0 ? "positive" : "negative";
    private static string Tone(double value) => value >= 0 ? "positive" : "negative";
    private static string Humanize(string value) => CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.Replace('-', ' '));
    private string SensitivityValue(decimal value) => _sensitivityMetric == "net-permanent-jobs"
        ? value.ToString("N1", CultureInfo.CurrentCulture)
        : Money(value);
    private string SignedSensitivityDelta(decimal value)
    {
        var formatted = SensitivityValue(Math.Abs(value));
        return value switch
        {
            > 0 => $"+{formatted}",
            < 0 => $"−{formatted}",
            _ => "no change"
        };
    }
    private static string Range(ParameterDefinition definition) =>
        definition.RecommendedMinimum is null && definition.RecommendedMaximum is null
            ? "not established"
            : $"{definition.RecommendedMinimum?.ToString(CultureInfo.InvariantCulture) ?? "−∞"}–{definition.RecommendedMaximum?.ToString(CultureInfo.InvariantCulture) ?? "+∞"}";
    private static string ComputationalRange(ParameterDefinition definition) =>
        $"{definition.ComputationalMinimum?.ToString(CultureInfo.InvariantCulture) ?? "−∞"}–{definition.ComputationalMaximum?.ToString(CultureInfo.InvariantCulture) ?? "+∞"}";
    private static bool NearlyEqual(double left, double right) => Math.Abs(left - right) <= 1e-9 * Math.Max(1, Math.Max(Math.Abs(left), Math.Abs(right)));

