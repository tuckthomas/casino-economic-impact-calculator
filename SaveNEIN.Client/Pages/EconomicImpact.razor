    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;
    private void ResetOverrides()
    {
        _overrides.Clear();
        _scenarioJsonMessage = "All user overrides were removed; selected parameter-set defaults are active.";
        _scenarioJsonError = false;
    }

    private void ResetStandardOverrides()
    {
        foreach (var key in StandardParameterKeys.Append("gravity.beta"))
        {
            _overrides.Remove(key);
        }
        _scenarioJsonMessage = "Standard controls were reset to their selected parameter-set defaults.";
        _scenarioJsonError = false;
    }

    private void ResetAdvancedOverrides()
    {
        if (_configuration is null)
        {
            return;
        }
        foreach (var definition in _configuration.ParameterDefinitions
                     .Where(definition => !StandardParameterKeys.Contains(definition.Key, StringComparer.Ordinal)))
        {
            _overrides.Remove(definition.Key);
        }
        _scenarioJsonMessage = "Advanced overrides were reset to their selected parameter-set defaults.";
        _scenarioJsonError = false;
    }

    private string TravelSensitivityPreset
    {
        get
        {
            var definition = FindParameter("gravity.beta");
            if (definition is null || !_overrides.TryGetValue(definition.Key, out var value))
            {
                return "base";
            }
            if (definition.RecommendedMinimum is { } minimum && NearlyEqual(value, minimum))
            {
                return "broad";
            }
            if (definition.RecommendedMaximum is { } maximum && NearlyEqual(value, maximum))
            {
                return "local";
            }
            return "custom";
        }
    }

    private void SetTravelSensitivityPreset(ChangeEventArgs args)
    {
        var definition = FindParameter("gravity.beta");
        if (definition is null)
        {
            return;
        }
        switch (args.Value?.ToString())
        {
            case "base":
                _overrides.Remove(definition.Key);
                break;
            case "broad" when definition.RecommendedMinimum is { } minimum:
                _overrides[definition.Key] = minimum;
                break;
            case "local" when definition.RecommendedMaximum is { } maximum:
                _overrides[definition.Key] = maximum;
                break;
            case "custom":
                _showAdvanced = true;
                _parameterSearch = "gravity.beta";
                break;
        }
    }

