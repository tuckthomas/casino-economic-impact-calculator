    private void SetOverride(ParameterDefinition definition, string? rawValue)
    {
        if (double.TryParse(rawValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            if (!double.IsFinite(value) ||
                definition.ComputationalMinimum is { } minimum && value < minimum ||
                definition.ComputationalMaximum is { } maximum && value > maximum)
            {
                _scenarioJsonMessage = $"{definition.DisplayName} must remain within hard bounds {ComputationalRange(definition)} {definition.Units}.";
                _scenarioJsonError = true;
                return;
            }
            _overrides[definition.Key] = value;
            _scenarioJsonMessage = null;
            _scenarioJsonError = false;
        }
    }

    private void ResetOverride(string key) => _overrides.Remove(key);

    private double ParameterValue(ParameterDefinition definition)
    {
        if (_overrides.TryGetValue(definition.Key, out var userValue))
        {
            return userValue;
        }
        return ParameterScenarioValue(definition);
    }

    private double ParameterScenarioValue(ParameterDefinition definition)
    {
        var selectedSets = new[]
        {
            _form.ScenarioParameterSetId,
            _form.JurisdictionParameterSetId,
            _form.NationalParameterSetId
        };
        foreach (var setId in selectedSets)
        {
            var setValue = _configuration?.ParameterSetValues.FirstOrDefault(value =>
                value.ParameterSetId == setId && value.ParameterKey == definition.Key);
            if (setValue is not null)
            {
                return setValue.Value;
            }
        }
        return definition.SystemDefaultValue;
    }

    private string ParameterSource(string key)
    {
        if (_overrides.ContainsKey(key))
        {
            return "User override";
        }
        var selectedSets = new[]
        {
            _form.ScenarioParameterSetId,
            _form.JurisdictionParameterSetId,
            _form.NationalParameterSetId
        };
        foreach (var setId in selectedSets)
        {
            if (_configuration?.ParameterSetValues.Any(value => value.ParameterSetId == setId && value.ParameterKey == key) == true)
            {
                return _configuration.ParameterSets.First(set => set.Id == setId).Name;
            }
        }
        return "System fallback";
    }

    private ParameterDefinition? FindParameter(string key) =>
        _configuration?.ParameterDefinitions.FirstOrDefault(definition => definition.Key == key);

    private string ScenarioModeLabel
    {
        get
        {
            if (_overrides.Count > 0)
            {
                return $"Custom ({_overrides.Count} override{(_overrides.Count == 1 ? string.Empty : "s")})";
            }
            var selected = _configuration?.ParameterSets.FirstOrDefault(set => set.Id == _form.ScenarioParameterSetId);
            return selected?.ScenarioKind switch
            {
                "conservative" => "Conservative",
                "high" => "High / aggressive",
                "base" => "Base",
                _ => "System / base"
            };
        }
