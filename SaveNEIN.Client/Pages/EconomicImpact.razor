@page "/economic-impact/model"
@inject HttpClient Http
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Rendering

@if (!Embedded)
{
    <PageTitle>Economic Impact Model | Save Northeast Indiana</PageTitle>
}

<section class="model-workbench" id="canonical-economic-model" aria-labelledby="model-workbench-title">
    <div class="model-workbench-shell">
        <header class="model-workbench-heading">
            <span class="model-eyebrow">Economic impact estimate</span>
            <h2 id="model-workbench-title">Estimate the impact of a proposed casino</h2>
            <p>
                Enter the details of a proposed facility to estimate its potential revenue and local economic impact.
                You can save estimates and compare different proposals or locations.
            </p>
        </header>

        @if (_loading)
        {
            <div class="model-status" role="status">Loading the information needed for your estimate…</div>
        }
        else if (_configuration is null)
        {
            <div class="model-alert model-alert-error" role="alert">
                <strong>Model configuration unavailable.</strong>
                <span>@(_error ?? "The server did not return a model catalog.")</span>
                <button type="button" @onclick="LoadAsync">Retry</button>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="model-alert model-alert-error" role="alert">
                    <strong>Scenario could not run.</strong>
                    <span>@_error</span>
                </div>
            }

            <div class="model-workbench-grid">
                <aside class="model-panel model-input-panel" aria-label="Scenario inputs">
                    <div class="model-panel-heading">
                        <div>
                            <span class="model-step">1</span>
                            <h3>Describe the proposal</h3>
                        </div>
                        <span class="model-version">@_configuration.ModelVersion</span>
                    </div>

                    <div class="model-form-grid">
                        <label class="model-field model-field-wide">
                            <span>Scenario name</span>
                            <input @bind="_form.ScenarioName" maxlength="120" />
                        </label>

                        <label class="model-field">
                            <span>Host jurisdiction</span>
                            <select @bind="_form.JurisdictionCode" @bind:after="OnJurisdictionChangedAsync">
                                <option value="">Select jurisdiction</option>
                                @foreach (var jurisdiction in _configuration.Jurisdictions.Where(item => item.Kind != "federal"))
                                {
                                    <option value="@jurisdiction.Code">@jurisdiction.Name (@jurisdiction.Code)</option>
                                }
                            </select>
                        </label>

                        <label class="model-field">
                            <span>Development program</span>
                            <select @bind="_form.DevelopmentProgramId">
                                <option value="">Select program</option>
                                @foreach (var program in _configuration.DevelopmentPrograms)
                                {
                                    <option value="@program.Id">@DevelopmentProgramLabel(program)</option>
                                }
                            </select>
                            <button type="button" class="model-link-button model-field-action" @onclick="ToggleProgramEditor">
                                @(_showProgramEditor ? "Cancel new program" : "Define a new facility program")
                            </button>
                            @if (!string.IsNullOrWhiteSpace(_programMessage))
                            {
                                <small class="@(_programError ? "model-program-message is-error" : "model-program-message")" role="status">@_programMessage</small>
                            }
                        </label>

                        <label class="model-field">
                            <span>Candidate latitude</span>
                            <input type="number" min="-90" max="90" step="0.000001" @bind="_form.CandidateLatitude" />
                        </label>

                        <label class="model-field">
                            <span>Candidate longitude</span>
                            <input type="number" min="-180" max="180" step="0.000001" @bind="_form.CandidateLongitude" />
                        </label>
                        <label class="model-field">
                            <span>Fiscal rule effective date</span>
                            <input type="date" @bind="_form.EffectiveOn" />
                            <small>Use the date when the proposed facility's tax rules should apply.</small>
                        </label>
                    </div>

                    @if (_showProgramEditor)
                    {
                        <fieldset class="model-program-editor">
                            <legend>Describe a new facility</legend>
                            <p>
                                Enter the planned size and amenities for the proposed facility.
                            </p>
                            <div class="model-form-grid">
                                <label class="model-field model-field-wide">
                                    <span>Program name</span>
                                    <input @bind="_programForm.Name" @bind:event="oninput" maxlength="200" placeholder="Proposed regional casino program" />
                                </label>
                                <label class="model-field">
                                    <span>Slots / VLT positions</span>
                                    <input type="number" min="0" step="1" @bind="_programForm.SlotOrVltPositions" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Table games</span>
                                    <input type="number" min="0" step="1" @bind="_programForm.TableGameCount" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Poker tables</span>
                                    <input type="number" min="0" step="1" @bind="_programForm.PokerTableCount" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Hotel rooms</span>
                                    <input type="number" min="0" step="1" @bind="_programForm.HotelRoomCount" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Gaming floor (sq. ft.)</span>
                                    <input type="number" min="0" step="100" @bind="_programForm.GamingFloorSquareFeet" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Food and beverage venues</span>
                                    <input type="number" min="0" step="1" @bind="_programForm.FoodBeverageVenueCount" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Event capacity</span>
                                    <input type="number" min="0" step="100" @bind="_programForm.EventCapacity" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Resort amenities</span>
                                    <input type="number" min="0" step="1" @bind="_programForm.ResortAmenityCount" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Capital cost (USD)</span>
                                    <input type="number" min="0" step="1000000" @bind="_programForm.CapitalCost" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Capital-cost dollar year</span>
                                    <input type="number" min="1900" max="2200" step="1" @bind="_programForm.CapitalCostDollarYear" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Planned opening date</span>
                                    <input type="date" @bind="_programForm.PlannedOpeningDate" @bind:event="oninput" />
                                </label>
                                <label class="model-field">
                                    <span>Stabilized year number</span>
                                    <input type="number" min="1" max="20" step="1" @bind="_programForm.StabilizedYearNumber" @bind:event="oninput" />
                                </label>
                                <label class="model-checkbox-field model-field-wide">
                                    <input type="checkbox" @bind="_programForm.HasSportsbook" />
                                    <span>Includes a sportsbook</span>
                                </label>
                            </div>
                            <div class="model-program-actions">
                                <button type="button" class="model-secondary-button" disabled="@(!CanCreateProgram || _creatingProgram)" @onclick="CreateProgramAsync">
                                    @(_creatingProgram ? "Storing program…" : "Store and select program")
                                </button>
                            </div>
                        </fieldset>
                    }

                    <div class="model-subsection">
                        <div class="model-subsection-heading">
                            <div>
                                <span class="model-step">2</span>
                                <h3>Choose the data for your estimate</h3>
                            </div>
                            <span class="model-count">@_origins.Count origins</span>
                        </div>

                        <div class="model-form-grid">
                            <label class="model-field">
                                <span>Origin geography</span>
                                <select @bind="_form.OriginGeographySnapshotId" @bind:after="LoadOriginsAsync">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("origin-geography"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Age population</span>
                                <select @bind="_form.AgePopulationSnapshotId">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("age-population"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Income / AGI</span>
                                <select @bind="_form.IncomeSnapshotId">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("income"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Casino competitors</span>
                                <select @bind="_form.CompetitorSnapshotId">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("competitors"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Observed performance</span>
                                <select @bind="_form.ObservedPerformanceSnapshotId" @bind:after="ApplySnapshotYears">
                                    <option value="">Select snapshot</option>
                                    @foreach (var snapshot in Snapshots("observed-performance"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Tourism (optional)</span>
                                <select @bind="_form.TourismSnapshotId" @bind:after="LoadTourismAsync">
                                    <option value="">No tourism snapshot</option>
                                    @foreach (var snapshot in Snapshots("tourism"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Traffic (optional)</span>
                                <select @bind="_form.TrafficSnapshotId" @bind:after="LoadTrafficAsync">
                                    <option value="">No traffic snapshot</option>
                                    @foreach (var snapshot in Snapshots("traffic"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Local sector inventory (optional)</span>
                                <select @bind="_form.LocalEconomicInventorySnapshotId">
                                    <option value="">Use parameterized sector priors</option>
                                    @foreach (var snapshot in Snapshots("local-economic-inventory"))
                                    {
                                        <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                                    }
                                </select>
                            </label>
                            <label class="model-field">
                                <span>Origin state/territory code</span>
                                <input @bind="_form.OriginStateCode" @bind:after="LoadOriginsAsync" maxlength="10" />
                            </label>
                        </div>

                        <div class="model-data-summary">
                            <span><strong>@_origins.Count</strong> ZCTA/flexible origins selected</span>
                            <span><strong>@_tourism.Count</strong> tourism observations selected</span>
                            <span><strong>@_traffic.Count</strong> traffic corridors selected</span>
                        </div>
                    </div>

                    <div class="model-subsection">
                        <div class="model-subsection-heading">
                            <div>
                                <span class="model-step">3</span>
                                <h3>Model assumptions</h3>
                            </div>
                            <button class="model-link-button" type="button" @onclick="ToggleAdvanced">
                                @(_showAdvanced ? "Hide advanced" : "Show advanced")
                            </button>
                        </div>

                        <div class="model-form-grid">
                            <label class="model-field">
                                <span>Scenario preset</span>
                                <select @bind="_form.ScenarioParameterSetId">
                                    <option value="">System/base values</option>
                                    @foreach (var set in _configuration.ParameterSets.Where(set => set.Scope == "scenario"))
                                    {
                                        <option value="@set.Id">@set.Name · @set.Version</option>
                                    }
                                </select>
                                <small>Mode: @ScenarioModeLabel</small>
                            </label>
                            <label class="model-field">
                                <span>Travel sensitivity</span>
                                <select value="@TravelSensitivityPreset" @onchange="SetTravelSensitivityPreset">
                                    <option value="base">Selected base value</option>
                                    <option value="broad">Broader regional draw</option>
                                    <option value="local">More local destination</option>
                                    <option value="custom">Custom beta override</option>
                                </select>
                                <small>Uses the validated beta range and still reruns the server model.</small>
                            </label>
                        </div>

                        <div class="model-section-toolbar">
                            <p>Common decisions use plain-language controls. Exact coefficients remain available below.</p>
                            <button type="button" class="model-link-button" @onclick="ResetStandardOverrides">Reset this section</button>
                        </div>
                        <div class="model-parameter-grid">
                            @foreach (var definition in StandardDefinitions())
                            {
                                @ParameterEditor(definition)
                            }
                        </div>

                        @if (_showAdvanced)
                        {
                            <div class="model-advanced" aria-label="Advanced model parameters">
                                <div class="model-advanced-toolbar">
                                    <label class="model-field">
                                        <span>Filter parameters</span>
                                        <input @bind="_parameterSearch" placeholder="beta, social cost, traffic…" />
                                    </label>
                                    <div class="model-advanced-actions">
                                        <button type="button" class="model-secondary-button" @onclick="ResetAdvancedOverrides">Reset this section</button>
                                        <button type="button" class="model-secondary-button" @onclick="ResetOverrides">Reset to selected defaults</button>
                                    </div>
                                </div>
                                <div class="model-form-grid model-specification-grid">
                                    <label class="model-field">
                                        <span>Demand specification</span>
                                        <select @bind="_form.DemandSpecification">
                                            <option value="agi-share">AGI-share demand</option>
                                            <option value="eligible-adult-per-capita">Eligible-adult per capita</option>
                                        </select>
                                    </label>
                                    <label class="model-field">
                                        <span>Facility attraction</span>
                                        <select @bind="_form.AttractionSpecification">
                                            <option value="observed-ggr">Observed-GGR mass</option>
                                            <option value="structural">Structural facility mass</option>
                                        </select>
                                    </label>
                                    <label class="model-field">
                                        <span>Travel-friction form</span>
                                        <select @bind="_form.FrictionForm">
                                            <option value="inverse-power">Inverse power (beta)</option>
                                            <option value="exponential">Exponential decay</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="model-parameter-grid">
                                    @foreach (var definition in AdvancedDefinitions())
                                    {
                                        @ParameterEditor(definition)
                                    }
                                </div>
                            </div>
                        }

                        <details class="model-scenario-json">
                            <summary>Save or load these proposal details</summary>
                            <p>
                                Save these details to reuse them later or share them with another reviewer. This includes
                                the proposal information, but not the calculated results.
                            </p>
                            <textarea @bind="_scenarioJson" @bind:event="oninput" rows="12" spellcheck="false" aria-label="Versioned scenario definition JSON"></textarea>
                            <div class="model-scenario-json-actions">
                                <button type="button" class="model-secondary-button" @onclick="ExportScenarioDefinition">Export current inputs to JSON</button>
                                <button type="button" class="model-secondary-button" @onclick="ImportScenarioDefinitionAsync">Import JSON into inputs</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_scenarioJsonMessage))
                            {
                                <p class="@(_scenarioJsonError ? "model-json-message is-error" : "model-json-message")" role="status">@_scenarioJsonMessage</p>
                            }
                        </details>
                    </div>

                    <div class="model-run-actions">
                        <button class="model-primary-button" type="button" disabled="@(!CanRun || _running)" @onclick="RunScenarioAsync">
                            @(_running ? "Calculating estimate…" : "Calculate and save estimate")
                        </button>
                        <span>@RunReadiness</span>
                    </div>
                </aside>

                <main class="model-results" aria-live="polite">
                    <div class="model-panel-heading model-results-heading">
                        <div>
                            <span class="model-step">4</span>
                            <h3>Estimate results</h3>
                        </div>
                        @if (_latestRun is not null)
                        {
                            <span class="model-run-id">@_latestRun.ModelRunId</span>
                        }
                    </div>

                    @if (_latestRun is null)
                    {
                        <div class="model-empty-state">
                            <span class="material-symbols-outlined" aria-hidden="true">database</span>
                            <h3>Your results will appear here</h3>
                            <p>Complete the required selections, then calculate an estimate.</p>
                        </div>
                    }
                    else
                    {
                        <section class="model-result-hero">
                            <span>Stabilized annual GGR</span>
                            <strong>@Money(_latestRun.StabilizedTotalGgr)</strong>
                            <p>@_latestRun.Status · @_latestRun.ComputationalOriginType.ToUpperInvariant() origins · @_latestRun.RoutingGraphHash[..Math.Min(12, _latestRun.RoutingGraphHash.Length)] routing graph</p>
                        </section>

                        <div class="model-metric-grid">
                            @Metric("Resident GGR", Money(_latestRun.ProposedResidentGgr))
                            @Metric("Tourism GGR", Money(_latestRun.TourismGgr))
                            @Metric("Traffic GGR", Money(_latestRun.TrafficGgr))
                            @Metric("Local displacement", Money(_latestRun.LocalDiscretionaryDisplacement), "negative")
                            @Metric("Gross gaming tax", Money(_latestRun.GrossGamingTax))
                            @Metric("Gross social cost", Money(_latestRun.GrossSocialCost), "negative")
                            @Metric("Net permanent jobs", Number(_latestRun.NetPermanentJobs), Tone(_latestRun.NetPermanentJobs))
                            @Metric("Net host-local impact", Money(_latestRun.NetHostLocalImpact), Tone(_latestRun.NetHostLocalImpact))
                            @Metric("Net host-state impact", Money(_latestRun.NetHostStateImpact), Tone(_latestRun.NetHostStateImpact))
                        </div>

                        <section class="model-decomposition">
                            <h4>Revenue source decomposition</h4>
                            @foreach (var source in _latestRun.ProposedCaptureBySource.OrderByDescending(item => item.Value))
                            {
                                <div class="model-bridge-row">
                                    <span>@Humanize(source.Key)</span>
                                    <strong>@Money(source.Value)</strong>
                                </div>
                            }
                        </section>

                        <div class="model-result-detail-grid">
                            <section class="model-result-table-section" aria-labelledby="model-origin-results-title">
                                <div class="model-result-table-heading">
                                    <div>
                                        <h4 id="model-origin-results-title">Patron-origin results</h4>
                                        <p>Shows where the estimated visitors and spending are expected to come from.</p>
                                    </div>
                                    <span>@_runOriginTotal origin(s)</span>
                                </div>
                                @if (_runOrigins.Count == 0)
                                {
                                    <p class="model-muted">No patron-origin rows were persisted for this run.</p>
                                }
                                else
                                {
                                    <div class="model-result-table-shell">
                                        <table class="model-result-table">
                                            <caption>Configurable top origin summary by proposed resident GGR; immaterial rows reconcile in Other origins.</caption>
                                            <thead>
                                                <tr>
                                                    <th scope="col">Origin</th>
                                                    <th scope="col">Resident demand</th>
                                                    <th scope="col">Proposed GGR</th>
                                                    <th scope="col">Outside-option capture</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var origin in _runOrigins)
                                                {
                                                    <tr>
                                                        <th scope="row">
                                                            @origin.Label
                                                            <small>@origin.OriginCount source origin(s)@(origin.IsResidual ? " · grouped residual" : string.Empty)</small>
                                                        </th>
                                                        <td>@Money(origin.ResidentDemand)</td>
                                                        <td>@Money(origin.TotalProposedResidentGgr)</td>
                                                        <td>@Money(origin.OutsideOptionCapture)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </section>

                            <section class="model-result-table-section" aria-labelledby="model-incumbent-results-title">
                                <div class="model-result-table-heading">
                                    <div>
                                        <h4 id="model-incumbent-results-title">Incumbent impacts</h4>
                                        <p>Baseline and with-project resident GGR from the same stored market equilibrium.</p>
                                    </div>
                                    <span>@_runFacilities.Count(facility => !facility.IsProposedFacility) incumbent(s)</span>
                                </div>
                                @if (_runFacilities.All(facility => facility.IsProposedFacility))
                                {
                                    <p class="model-muted">No incumbent facility impacts were persisted for this run.</p>
                                }
                                else
                                {
                                    <div class="model-result-table-shell">
                                        <table class="model-result-table">
                                            <caption>Per-incumbent resident GGR before and after the proposed facility enters the competitive market.</caption>
                                            <thead>
                                                <tr>
                                                    <th scope="col">Facility</th>
                                                    <th scope="col">Baseline</th>
                                                    <th scope="col">With project</th>
                                                    <th scope="col">Change</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var facility in _runFacilities.Where(facility => !facility.IsProposedFacility).OrderBy(facility => facility.ChangeInResidentGgr))
                                                {
                                                    <tr>
                                                        <th scope="row">@facility.FacilityKey</th>
                                                        <td>@Money(facility.BaselineResidentGgr)</td>
                                                        <td>@Money(facility.WithProjectResidentGgr)</td>
                                                        <td class="@Tone(facility.ChangeInResidentGgr)">@Money(facility.ChangeInResidentGgr)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </section>
                        </div>

                        @if (_latestRun.Warnings.Count > 0)
                        {
                            <details class="model-warning-list">
                                <summary>@_latestRun.Warnings.Count model warning(s)</summary>
                                <ul>
                                    @foreach (var warning in _latestRun.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </details>
                        }

                        <section class="model-report-actions" aria-label="Full analytical report">
                            <div>
                                <h4>Download the full report</h4>
                                <p>Download this estimate as a PDF, web page, spreadsheet, or data file.</p>
                            </div>
                            <button type="button" class="model-primary-button" disabled="@_generatingReport" @onclick="GenerateReportAsync">
                                @(_generatingReport ? "Rendering server report…" : "Generate full report")
                            </button>
                            @if (_reportArtifact is not null)
                            {
                                <nav class="model-report-downloads" aria-label="Report downloads">
                                    <a href="@_reportArtifact.PdfUrl" target="_blank" rel="noopener">PDF</a>
                                    <a href="@_reportArtifact.HtmlUrl" target="_blank" rel="noopener">HTML</a>
                                    <a href="@_reportArtifact.JsonUrl" target="_blank" rel="noopener">JSON</a>
                                    <a href="@_reportArtifact.CsvUrl">CSV</a>
                                </nav>
                            }
                        </section>

                        <section class="model-sensitivity" aria-labelledby="model-sensitivity-title">
                            <div class="model-subsection-heading">
                                <div>
                                    <span class="model-step">5</span>
                                    <h3 id="model-sensitivity-title">See how the estimate could change</h3>
                                </div>
                                <span class="model-count">@SelectedSensitivityRunCount full runs</span>
                            </div>
                            <p class="model-muted">
                                Test different assumptions to see which factors have the biggest effect on the estimate.
                            </p>

                            <label class="model-field model-sensitivity-metric">
                                <span>Tornado output metric</span>
                                <select @bind="_sensitivityMetric">
                                    <option value="stabilized-total-ggr">Stabilized total GGR</option>
                                    <option value="gross-gaming-tax">Gross gaming tax</option>
                                    <option value="gross-social-cost">Gross social cost</option>
                                    <option value="local-discretionary-displacement">Local discretionary displacement</option>
                                    <option value="net-permanent-jobs">Net permanent jobs</option>
                                    <option value="net-host-local-impact">Net host-local impact</option>
                                    <option value="net-host-state-impact">Net host-state impact</option>
                                </select>
                            </label>

                            <div class="model-sensitivity-ranges">
                                @foreach (var range in _sensitivityRanges)
                                {
                                    <div class="model-sensitivity-range">
                                        <label class="model-sensitivity-toggle">
                                            <input type="checkbox" @bind="range.Selected" />
                                            <span>
                                                <strong>@range.DisplayName</strong>
                                                <small>@range.ParameterKey · baseline @range.BaseValue.ToString("G6", CultureInfo.InvariantCulture) @range.Units</small>
                                            </span>
                                        </label>
                                        <label>
                                            <span>Low</span>
                                            <input type="number" step="@range.Step" @bind="range.LowValue" aria-label="Low value for @range.DisplayName" />
                                        </label>
                                        <label>
                                            <span>High</span>
                                            <input type="number" step="@range.Step" @bind="range.HighValue" aria-label="High value for @range.DisplayName" />
                                        </label>
                                    </div>
                                }
                            </div>

                            <button type="button" class="model-secondary-button model-sensitivity-run" disabled="@(!CanRunSensitivity || _runningSensitivity)" @onclick="RunSensitivityAsync">
                                @(_runningSensitivity ? $"Running {SelectedSensitivityRunCount} complete models…" : "Run and store sensitivity")
                            </button>

                            @if (_sensitivityResult is not null)
                            {
                                <div class="model-sensitivity-table-shell">
                                    <table class="model-sensitivity-table">
                                        <caption>
                                            Tornado table · @_sensitivityResult.OutputMetric · analysis @_sensitivityResult.SensitivityAnalysisId
                                        </caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Parameter</th>
                                                <th scope="col">Low result</th>
                                                <th scope="col">Baseline</th>
                                                <th scope="col">High result</th>
                                                <th scope="col">Full range</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in _sensitivityResult.Tornado)
                                            {
                                                <tr>
                                                    <th scope="row">@Humanize(row.ParameterKey)</th>
                                                    <td>@SensitivityValue(row.LowMetricValue)<small>@SignedSensitivityDelta(row.LowDelta)</small></td>
                                                    <td>@SensitivityValue(row.BaseMetricValue)</td>
                                                    <td>@SensitivityValue(row.HighMetricValue)<small>@SignedSensitivityDelta(row.HighDelta)</small></td>
                                                    <td>@SensitivityValue(row.TotalRange)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <button type="button" class="model-secondary-button model-sensitivity-run" disabled="@_generatingReport" @onclick="GenerateSensitivityReportAsync">
                                    @(_generatingReport ? "Rendering sensitivity report…" : "Generate report with sensitivity exhibit")
                                </button>
                            }
                        </section>
                    }

                    <section class="model-comparison" id="economic-analysis-part-2">
                        <div class="model-subsection-heading">
                            <div>
                                <span class="model-step">6</span>
                                <h3>Compare saved estimates</h3>
                            </div>
                            <button type="button" class="model-secondary-button" disabled="@(_comparisonSelection.Count < 2 || _comparing)" @onclick="CompareAsync">
                                @(_comparing ? "Loading…" : "Compare selected")
                            </button>
                        </div>

                        @if (_recentRuns.Count == 0)
                        {
                            <p class="model-muted">No stored runs are available yet.</p>
                        }
                        else
                        {
                            <div class="model-run-list">
                                @foreach (var run in _recentRuns)
                                {
                                    <label>
                                        <input type="checkbox" checked="@_comparisonSelection.Contains(run.Id)" @onchange="args => ToggleComparison(run.Id, args)" />
                                        <span>
                                            <strong>@run.ScenarioName</strong>
                                            <small>@run.CreatedAtUtc.ToLocalTime().ToString("g") · @run.Status</small>
                                        </span>
                                    </label>
                                }
                            </div>
                        }

                        @if (_comparison.Count >= 2)
                        {
                            <div class="model-comparison-table-shell">
                                <table class="model-comparison-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Metric</th>
                                            @foreach (var run in _comparison)
                                            {
                                                <th scope="col">@run.ScenarioName</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @ComparisonRow("Stabilized GGR", run => Money(run.StabilizedTotalGgr))
                                        @ComparisonRow("Resident GGR", run => Money(run.TotalWithProjectResidentGgr))
                                        @ComparisonRow("Tourism GGR", run => Money(run.TourismGgr))
                                        @ComparisonRow("Traffic GGR", run => Money(run.TrafficGgr))
                                        @ComparisonRow("Local displacement", run => Money(run.LocalDiscretionaryDisplacement))
                                        @ComparisonRow("Gross gaming tax", run => Money(run.GrossGamingTax))
                                        @ComparisonRow("Gross social cost", run => Money(run.GrossSocialCost))
                                        @ComparisonRow("Net permanent jobs", run => Number(run.NetPermanentJobs))
                                        @ComparisonRow("Net host-local impact", run => Money(run.NetHostLocalImpact))
                                        @ComparisonRow("Net host-state impact", run => Money(run.NetHostStateImpact))
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                </main>
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public bool Embedded { get; set; }

    [Parameter]
    public string? ScenarioToken { get; set; }

    private static readonly string[] StandardParameterKeys =
    [
        "demand.regional_intensity_multiplier",
        "market_expansion.accessibility_elasticity",
        "tourism.capture_rate",
        "traffic.intercept_rate",
        "displacement.local_patron_share",
        "displacement.eligible_base_share",
        "displacement.coefficient",
        "social_cost.prevalence",
        "ramp.first_year_share",
        "ramp.second_year_share"
    ];
    private static readonly string[] SensitivityParameterKeys =
    [
        "gravity.beta",
        "gravity.alpha",
        "demand.regional_intensity_multiplier",
        "tourism.capture_rate",
        "traffic.intercept_rate",
        "displacement.eligible_base_share",
        "displacement.coefficient",
        "social_cost.prevalence"
    ];
    private static readonly string[] DefaultSensitivityParameterKeys =
    [
        "gravity.beta",
        "demand.regional_intensity_multiplier",
        "displacement.coefficient",
        "social_cost.prevalence"
    ];
    private static readonly JsonSerializerOptions ScenarioJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };

    private ModelConfiguration? _configuration;
    private readonly ScenarioForm _form = new();
    private readonly DevelopmentProgramForm _programForm = new();
    private readonly Dictionary<string, double> _overrides = new(StringComparer.Ordinal);
    private readonly List<OriginOption> _origins = [];
    private readonly List<TourismObservation> _tourism = [];
    private readonly List<TrafficObservation> _traffic = [];
    private readonly List<RecentRun> _recentRuns = [];
    private readonly HashSet<Guid> _comparisonSelection = [];
    private readonly List<ComparisonRun> _comparison = [];
    private readonly List<SensitivityRangeForm> _sensitivityRanges = [];
    private readonly List<RunOriginSummaryRow> _runOrigins = [];
    private readonly List<RunFacilityResult> _runFacilities = [];
    private int _runOriginTotal;
    private RunResult? _latestRun;
    private RunRequest? _lastRunRequest;
    private bool _loading = true;
    private bool _running;
    private bool _showAdvanced;
    private bool _showProgramEditor;
    private bool _creatingProgram;
    private bool _comparing;
    private bool _generatingReport;
    private bool _runningSensitivity;
    private string? _error;
    private string _parameterSearch = string.Empty;
    private string _scenarioJson = string.Empty;
    private string? _scenarioJsonMessage;
    private bool _scenarioJsonError;
    private string? _programMessage;
    private bool _programError;
    private ReportArtifact? _reportArtifact;
    private SensitivityAnalysisResult? _sensitivityResult;
    private string _sensitivityMetric = "net-host-local-impact";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _configuration = await Http.GetFromJsonAsync<ModelConfiguration>("api/gravity-model-configuration");
            if (_configuration is null)
            {
                throw new InvalidOperationException("The model catalog response was empty.");
            }
            ApplyCatalogDefaults();
            await ApplyClientScenarioAsync();
            await LoadOriginsAsync();
            await LoadTourismAsync();
            await LoadTrafficAsync();
            await LoadRecentRunsAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _configuration = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyClientScenarioAsync()
    {
        if (_configuration is null || string.IsNullOrWhiteSpace(ScenarioToken))
        {
            return;
        }

        try
        {
            using var response = await Http.GetAsync(
                $"api/economic-scenarios/{Uri.EscapeDataString(ScenarioToken)}");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var scenario = await response.Content.ReadFromJsonAsync<ClientScenarioSnapshot>();
            if (scenario is null)
            {
                return;
            }

            _form.CandidateLatitude = scenario.MarkerLatitude;
            _form.CandidateLongitude = scenario.MarkerLongitude;
            _form.ScenarioName = string.IsNullOrWhiteSpace(scenario.CountyFips)
                ? "Economic impact scenario"
                : $"Economic impact scenario — county {scenario.CountyFips}";

            var stateCode = StateCodeFromFips(scenario.StateFips);
            var jurisdiction = _configuration.Jurisdictions.FirstOrDefault(item =>
                StateCode(item.Code).Equals(stateCode, StringComparison.OrdinalIgnoreCase));
            if (jurisdiction is not null)
            {
                _form.JurisdictionCode = jurisdiction.Code;
                _form.OriginStateCode = stateCode;
                ApplyJurisdictionParameterSet();
            }
        }
        catch (Exception exception)
        {
            _error = $"The saved Part 1 location could not be loaded: {exception.Message}";
        }
    }

    private static string StateCodeFromFips(string? stateFips) => stateFips switch
    {
        "01" => "AL", "02" => "AK", "04" => "AZ", "05" => "AR", "06" => "CA",
        "08" => "CO", "09" => "CT", "10" => "DE", "11" => "DC", "12" => "FL",
        "13" => "GA", "15" => "HI", "16" => "ID", "17" => "IL", "18" => "IN",
        "19" => "IA", "20" => "KS", "21" => "KY", "22" => "LA", "23" => "ME",
        "24" => "MD", "25" => "MA", "26" => "MI", "27" => "MN", "28" => "MS",
        "29" => "MO", "30" => "MT", "31" => "NE", "32" => "NV", "33" => "NH",
        "34" => "NJ", "35" => "NM", "36" => "NY", "37" => "NC", "38" => "ND",
        "39" => "OH", "40" => "OK", "41" => "OR", "42" => "PA", "44" => "RI",
        "45" => "SC", "46" => "SD", "47" => "TN", "48" => "TX", "49" => "UT",
        "50" => "VT", "51" => "VA", "53" => "WA", "54" => "WV", "55" => "WI",
        "56" => "WY", "60" => "AS", "66" => "GU", "69" => "MP", "72" => "PR",
        "78" => "VI", _ => string.Empty
    };

    private void ApplyCatalogDefaults()
    {
        if (_configuration is null)
        {
            return;
        }
        var jurisdiction = _configuration.Jurisdictions.FirstOrDefault(item => item.Kind == "state")
                           ?? _configuration.Jurisdictions.FirstOrDefault(item => item.Kind != "federal");
        _form.JurisdictionCode = jurisdiction?.Code ?? string.Empty;
        _form.OriginStateCode = StateCode(_form.JurisdictionCode);
        _form.DevelopmentProgramId = _configuration.DevelopmentPrograms.FirstOrDefault()?.Id;
        _form.OriginGeographySnapshotId = LatestSnapshotId("origin-geography");
        _form.AgePopulationSnapshotId = LatestSnapshotId("age-population");
        _form.IncomeSnapshotId = LatestSnapshotId("income");
        _form.CompetitorSnapshotId = LatestSnapshotId("competitors");
        _form.ObservedPerformanceSnapshotId = LatestSnapshotId("observed-performance");
        _form.TourismSnapshotId = LatestSnapshotId("tourism");
        _form.TrafficSnapshotId = LatestSnapshotId("traffic");
        _form.NationalParameterSetId = _configuration.ParameterSets.FirstOrDefault(set => set.Scope == "national")?.Id;
        ApplyJurisdictionParameterSet();
        _form.ScenarioParameterSetId = _configuration.ParameterSets.FirstOrDefault(set => set.ScenarioKind == "base")?.Id;
        ApplySnapshotYears();
    }

    private async Task OnJurisdictionChangedAsync()
    {
        _form.OriginStateCode = StateCode(_form.JurisdictionCode);
        ApplyJurisdictionParameterSet();
        await LoadOriginsAsync();
    }

    private void ToggleProgramEditor()
    {
        _showProgramEditor = !_showProgramEditor;
        _programMessage = null;
        _programError = false;
    }

    private async Task CreateProgramAsync()
    {
        if (!CanCreateProgram || _configuration is null)
        {
            return;
        }
        _creatingProgram = true;
        _programMessage = null;
        _programError = false;
        try
        {
            var request = new DevelopmentProgramCreateRequest(
                $"interactive-{Guid.NewGuid():N}",
                "1",
                _programForm.Name.Trim(),
                _programForm.SlotOrVltPositions!.Value,
                _programForm.TableGameCount!.Value,
                _programForm.PokerTableCount ?? 0,
                _programForm.HasSportsbook,
                _programForm.HotelRoomCount ?? 0,
                _programForm.GamingFloorSquareFeet ?? 0,
                _programForm.FoodBeverageVenueCount ?? 0,
                _programForm.EventCapacity ?? 0,
                _programForm.ResortAmenityCount ?? 0,
                _programForm.CapitalCost,
                _programForm.CapitalCostDollarYear,
                _programForm.PlannedOpeningDate,
                _programForm.StabilizedYearNumber ?? 3,
                "Created through the stored-run casino impact workbench.");
            using var response = await Http.PostAsJsonAsync("api/development-programs", request);
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException($"{(int)response.StatusCode} {response.ReasonPhrase}: {await response.Content.ReadAsStringAsync()}");
            }
            var program = await response.Content.ReadFromJsonAsync<DevelopmentProgramOption>()
                          ?? throw new InvalidOperationException("The development program was stored without a response body.");
            _configuration.DevelopmentPrograms.Insert(0, program);
            _form.DevelopmentProgramId = program.Id;
            _showProgramEditor = false;
            _programMessage = $"Stored and selected {program.Name} v{program.Version}.";
            _programForm.Reset();
        }
        catch (Exception exception)
        {
            _programMessage = exception.Message;
            _programError = true;
        }
        finally
        {
            _creatingProgram = false;
        }
    }

    private void ApplyJurisdictionParameterSet()
    {
        if (_configuration is null)
        {
            return;
        }
        var jurisdiction = _configuration.Jurisdictions.FirstOrDefault(item => item.Code == _form.JurisdictionCode);
        _form.JurisdictionParameterSetId = _configuration.ParameterSets
            .FirstOrDefault(set => set.Scope == "jurisdiction" && set.JurisdictionId == jurisdiction?.Id)?.Id;
    }

    private async Task LoadOriginsAsync()
    {
        _origins.Clear();
        if (_form.OriginGeographySnapshotId is not { } snapshotId)
        {
            return;
        }
        var url = $"api/gravity-model-configuration/origins?datasetSnapshotId={snapshotId}&take=10000";
        if (!string.IsNullOrWhiteSpace(_form.OriginStateCode))
        {
            url += $"&stateCode={Uri.EscapeDataString(_form.OriginStateCode.Trim().ToUpperInvariant())}";
        }
        var response = await Http.GetFromJsonAsync<OriginResponse>(url);
        if (response is not null)
        {
            _origins.AddRange(response.Origins);
        }
    }

    private async Task LoadTourismAsync()
    {
        _tourism.Clear();
        if (_form.TourismSnapshotId is not { } snapshotId)
        {
            return;
        }
        var rows = await Http.GetFromJsonAsync<List<TourismObservation>>(
            $"api/gravity-model-configuration/tourism-observations?datasetSnapshotId={snapshotId}");
        if (rows is not null)
        {
            _tourism.AddRange(rows);
        }
    }

    private async Task LoadTrafficAsync()
    {
        _traffic.Clear();
        if (_form.TrafficSnapshotId is not { } snapshotId)
        {
            return;
        }
        var rows = await Http.GetFromJsonAsync<List<TrafficObservation>>(
            $"api/gravity-model-configuration/traffic-observations?datasetSnapshotId={snapshotId}");
        if (rows is not null)
        {
            _traffic.AddRange(rows);
        }
    }

    private async Task LoadRecentRunsAsync()
    {
        _recentRuns.Clear();
        var runs = await Http.GetFromJsonAsync<List<RecentRun>>("api/gravity-model-runs?take=20");
        if (runs is not null)
        {
            _recentRuns.AddRange(runs);
        }
    }

    private async Task LoadRunOutputDetailsAsync(Guid modelRunId)
    {
        _runFacilities.Clear();
        _runOrigins.Clear();
        _runOriginTotal = 0;

        var detailsTask = Http.GetFromJsonAsync<RunDetails>($"api/gravity-model-runs/{modelRunId}");
        var originsTask = Http.GetFromJsonAsync<RunOriginSummaryResponse>(
            $"api/gravity-model-runs/{modelRunId}/origin-summaries?dimension=origin&top=25&minimumShare=0.001");
        await Task.WhenAll(detailsTask, originsTask);

        var details = await detailsTask;
        if (details is not null)
        {
            _runFacilities.AddRange(details.Facilities);
        }
        var origins = await originsTask;
        if (origins is not null)
        {
            _runOriginTotal = origins.UnderlyingOriginCount;
            _runOrigins.AddRange(origins.Rows);
        }
    }

    private async Task RunScenarioAsync()
    {
        if (!CanRun)
        {
            return;
        }
        _running = true;
        _error = null;
        _runFacilities.Clear();
        _runOrigins.Clear();
        _runOriginTotal = 0;
        try
        {
            var observedSnapshot = FindSnapshot(_form.ObservedPerformanceSnapshotId!.Value)!;
            var request = new RunRequest
            {
                ScenarioName = _form.ScenarioName.Trim(),
                JurisdictionCode = _form.JurisdictionCode,
                DevelopmentProgramId = _form.DevelopmentProgramId!.Value,
                CandidateLatitude = _form.CandidateLatitude!.Value,
                CandidateLongitude = _form.CandidateLongitude!.Value,
                OriginGeographySnapshotId = _form.OriginGeographySnapshotId!.Value,
                AgePopulationSnapshotId = _form.AgePopulationSnapshotId!.Value,
                IncomeSnapshotId = _form.IncomeSnapshotId!.Value,
                CompetitorSnapshotId = _form.CompetitorSnapshotId!.Value,
                ObservedPerformanceSnapshotId = _form.ObservedPerformanceSnapshotId!.Value,
                StableOriginIds = _origins.Select(origin => origin.StableOriginId).ToArray(),
                CompetitorIds = [],
                PopulationObservationYear = FindSnapshot(_form.AgePopulationSnapshotId!.Value)?.PeriodEnd.Year ?? observedSnapshot.PeriodEnd.Year,
                IncomeTaxYear = FindSnapshot(_form.IncomeSnapshotId!.Value)?.PeriodEnd.Year ?? observedSnapshot.PeriodEnd.Year,
                EffectiveOn = _form.EffectiveOn,
                FacilityRegime = _form.FacilityRegime,
                DemandSpecification = _form.DemandSpecification,
                AttractionSpecification = _form.AttractionSpecification,
                FrictionForm = _form.FrictionForm,
                ObservedMetricKey = _form.ObservedMetricKey,
                ObservedPeriodStart = observedSnapshot.PeriodStart,
                ObservedPeriodEnd = observedSnapshot.PeriodEnd,
                NationalParameterSetId = _form.NationalParameterSetId,
                JurisdictionParameterSetId = _form.JurisdictionParameterSetId,
                ScenarioParameterSetId = _form.ScenarioParameterSetId,
                UserOverrides = _overrides.Select(item => new ParameterOverrideRequest(item.Key, item.Value)).ToArray(),
                CostingProfile = "auto",
                CompetitorPrefilterMiles = 300,
                TourismSnapshotId = _tourism.Count == 0 ? null : _form.TourismSnapshotId,
                TourismObservationIds = _tourism.Count == 0 ? null : _tourism.Select(item => item.StableObservationId).ToArray(),
                TrafficSnapshotId = _traffic.Count == 0 ? null : _form.TrafficSnapshotId,
                TrafficCorridors = _traffic.Count == 0
                    ? null
                    : _traffic.Select(item => new TrafficSelectionRequest(item.StableObservationId, 0.5, 1)).ToArray(),
                ImpactGeography = new ImpactGeographyRequest("host-state", _form.JurisdictionCode),
                LocalEconomicInventorySnapshotId = _form.LocalEconomicInventorySnapshotId
            };
            using var response = await Http.PostAsJsonAsync("api/gravity-model-runs", request);
            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"{(int)response.StatusCode} {response.ReasonPhrase}: {detail}");
            }
            _latestRun = await response.Content.ReadFromJsonAsync<RunResult>()
                         ?? throw new InvalidOperationException("The model run completed without a result body.");
            await LoadRunOutputDetailsAsync(_latestRun.ModelRunId);
            _lastRunRequest = request;
            ResetSensitivityRanges();
            _sensitivityResult = null;
            await LoadRecentRunsAsync();
            _comparisonSelection.Add(_latestRun.ModelRunId);
            _reportArtifact = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RunSensitivityAsync()
    {
        if (!CanRunSensitivity || _lastRunRequest is null)
        {
            return;
        }
        _runningSensitivity = true;
        _error = null;
        try
        {
            var selected = _sensitivityRanges.Where(range => range.Selected).ToArray();
            var request = new SensitivityAnalysisRequest(
                $"interactive-{Guid.NewGuid():N}",
                "1",
                $"{_lastRunRequest.ScenarioName} one-at-a-time sensitivity",
                _sensitivityMetric,
                _lastRunRequest,
                selected.Select(range => new SensitivityParameterRangeRequest(
                    range.ParameterKey,
                    range.LowValue,
                    range.HighValue)).ToArray());
            using var response = await Http.PostAsJsonAsync("api/model-sensitivity", request);
            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"{(int)response.StatusCode} {response.ReasonPhrase}: {detail}");
            }
            _sensitivityResult = await response.Content.ReadFromJsonAsync<SensitivityAnalysisResult>()
                                 ?? throw new InvalidOperationException("Sensitivity execution completed without a result body.");
            await LoadRecentRunsAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _runningSensitivity = false;
        }
    }

    private void ResetSensitivityRanges()
    {
        _sensitivityRanges.Clear();
        if (_configuration is null)
        {
            return;
        }
        foreach (var key in SensitivityParameterKeys)
        {
            var definition = _configuration.ParameterDefinitions.FirstOrDefault(item => item.Key == key);
            if (definition is null)
            {
                continue;
            }
            var baseline = ParameterValue(definition);
            var step = definition.UiStep ?? Math.Max(Math.Abs(baseline) * 0.1, 0.01);
            var low = definition.RecommendedMinimum ?? baseline - step * 2;
            var high = definition.RecommendedMaximum ?? baseline + step * 2;
            low = Math.Min(low, baseline);
            high = Math.Max(high, baseline);
            if (definition.ComputationalMinimum is { } minimum) low = Math.Max(low, minimum);
            if (definition.ComputationalMaximum is { } maximum) high = Math.Min(high, maximum);
            if (low >= high)
            {
                low = Math.Max(definition.ComputationalMinimum ?? double.MinValue, baseline - step);
                high = Math.Min(definition.ComputationalMaximum ?? double.MaxValue, baseline + step);
            }
            _sensitivityRanges.Add(new SensitivityRangeForm
            {
                ParameterKey = key,
                DisplayName = definition.DisplayName,
                Units = definition.Units,
                BaseValue = baseline,
                LowValue = low,
                HighValue = high,
                Step = step,
                Selected = DefaultSensitivityParameterKeys.Contains(key, StringComparer.Ordinal)
            });
        }
    }

    private async Task GenerateReportAsync()
    {
        if (_latestRun is null)
        {
            return;
        }
        await GenerateReportForRunAsync(_latestRun.ModelRunId, null, _form.ScenarioName.Trim());
    }

    private async Task GenerateSensitivityReportAsync()
    {
        if (_sensitivityResult is null || _lastRunRequest is null)
        {
            return;
        }
        await GenerateReportForRunAsync(
            _sensitivityResult.BaselineModelRunId,
            _sensitivityResult.SensitivityAnalysisId,
            $"{_lastRunRequest.ScenarioName} sensitivity baseline");
    }

    private async Task GenerateReportForRunAsync(Guid modelRunId, Guid? sensitivityAnalysisId, string scenarioName)
    {
        _generatingReport = true;
        _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/model-runs/{modelRunId:D}/reports",
                new ReportOptions($"Casino revenue and economic-impact analysis — {scenarioName}", null, 20, "USD", sensitivityAnalysisId));
            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"{(int)response.StatusCode} {response.ReasonPhrase}: {detail}");
            }
            _reportArtifact = await response.Content.ReadFromJsonAsync<ReportArtifact>()
                              ?? throw new InvalidOperationException("The report completed without artifact metadata.");
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _generatingReport = false;
        }
    }

    private async Task CompareAsync()
    {
        if (_comparisonSelection.Count < 2)
        {
            return;
        }
        _comparing = true;
        _error = null;
        try
        {
            var query = string.Join("&", _comparisonSelection.Select(id => $"modelRunIds={id}"));
            var runs = await Http.GetFromJsonAsync<List<ComparisonRun>>($"api/gravity-model-runs/comparison?{query}");
            _comparison.Clear();
            if (runs is not null)
            {
                _comparison.AddRange(runs);
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _comparing = false;
        }
    }

