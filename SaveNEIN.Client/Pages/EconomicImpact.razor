    private IEnumerable<ParameterDefinition> StandardDefinitions()
    {
        if (_configuration is null)
        {
            return [];
        }

        return _configuration.ParameterDefinitions
            .Where(definition => StandardParameterKeys.Contains(definition.Key, StringComparer.Ordinal))
            .OrderBy(definition => Array.IndexOf(StandardParameterKeys, definition.Key));
    }

    private IEnumerable<ParameterDefinition> AdvancedDefinitions()
    {
        if (_configuration is null)
        {
            return [];
        }
        return _configuration.ParameterDefinitions
            .Where(definition => !StandardParameterKeys.Contains(definition.Key, StringComparer.Ordinal))
            .Where(definition => string.IsNullOrWhiteSpace(_parameterSearch) ||
                                 definition.Key.Contains(_parameterSearch, StringComparison.OrdinalIgnoreCase) ||
                                 definition.DisplayName.Contains(_parameterSearch, StringComparison.OrdinalIgnoreCase) ||
                                 definition.Category.Contains(_parameterSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(definition => definition.Category)
            .ThenBy(definition => definition.DisplayName);
    }

    private RenderFragment ParameterEditor(ParameterDefinition Definition) => builder =>
    {
        var sequence = 0;
        var value = ParameterValue(Definition);
        var overridden = _overrides.ContainsKey(Definition.Key);
        var outside = Definition.RecommendedMinimum is { } minimum && value < minimum ||
                      Definition.RecommendedMaximum is { } maximum && value > maximum;
        builder.OpenElement(sequence++, "label");
        builder.AddAttribute(sequence++, "class", $"model-parameter{(overridden ? " is-overridden" : "")}{(outside ? " is-outside-range" : "")}");
        builder.OpenElement(sequence++, "span");
        builder.AddContent(sequence++, Definition.DisplayName);
        builder.CloseElement();
        builder.OpenElement(sequence++, "input");
        builder.AddAttribute(sequence++, "type", "number");
        builder.AddAttribute(sequence++, "step", Definition.UiStep ?? 0.01);
        if (Definition.ComputationalMinimum is { } hardMinimum) builder.AddAttribute(sequence++, "min", hardMinimum);
        if (Definition.ComputationalMaximum is { } hardMaximum) builder.AddAttribute(sequence++, "max", hardMaximum);
        builder.AddAttribute(sequence++, "value", value.ToString(CultureInfo.InvariantCulture));
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => SetOverride(Definition, args.Value?.ToString())));
        builder.CloseElement();
        builder.OpenElement(sequence++, "small");
        builder.AddContent(sequence++, $"{Definition.Units} · recommended {Range(Definition)}");
        builder.CloseElement();
        builder.OpenElement(sequence++, "em");
        builder.AddContent(sequence++, outside ? "Outside recommended range" : overridden ? "Custom override" : ParameterSource(Definition.Key));
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment Metric(string Label, string Value, string? Tone = null) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"model-metric {Tone}");
        builder.OpenElement(2, "span");
        builder.AddContent(3, Label);
        builder.CloseElement();
        builder.OpenElement(4, "strong");
        builder.AddContent(5, Value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment ComparisonRow(string Label, Func<ComparisonRun, string> Value) => builder =>
    {
        builder.OpenElement(0, "tr");
        builder.OpenElement(1, "th");
        builder.AddAttribute(2, "scope", "row");
        builder.AddContent(3, Label);
        builder.CloseElement();
        var sequence = 4;
        foreach (var run in _comparison)
        {
            builder.OpenElement(sequence++, "td");
            builder.AddContent(sequence++, Value(run));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private void SetOverride(ParameterDefinition definition, string? rawValue)
    {
        if (double.TryParse(rawValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            _overrides[definition.Key] = value;
        }
    }

    private double ParameterValue(ParameterDefinition definition)
    {
        if (_overrides.TryGetValue(definition.Key, out var userValue))
        {
            return userValue;
        }
        var selectedSets = new[]
        {
            _form.ScenarioParameterSetId,
            _form.JurisdictionParameterSetId,
            _form.NationalParameterSetId
        };
        foreach (var setId in selectedSets)
        {
            var setValue = _configuration?.ParameterSetValues.FirstOrDefault(value =>
                value.ParameterSetId == setId && value.ParameterKey == definition.Key);
            if (setValue is not null)
            {
                return setValue.Value;
            }
        }
        return definition.SystemDefaultValue;
    }

    private string ParameterSource(string key)
    {
        var selectedSets = new[]
        {
            _form.ScenarioParameterSetId,
            _form.JurisdictionParameterSetId,
            _form.NationalParameterSetId
        };
        foreach (var setId in selectedSets)
        {
            if (_configuration?.ParameterSetValues.Any(value => value.ParameterSetId == setId && value.ParameterKey == key) == true)
            {
                return _configuration.ParameterSets.First(set => set.Id == setId).Name;
            }
        }
        return "System fallback";
    }

