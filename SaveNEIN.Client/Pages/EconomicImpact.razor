            ModelVersion = _configuration.ModelVersion,
            ScenarioName = _form.ScenarioName,
            JurisdictionCode = _form.JurisdictionCode,
            OriginStateCode = _form.OriginStateCode,
            DevelopmentProgramId = _form.DevelopmentProgramId,
            CandidateLatitude = _form.CandidateLatitude,
            CandidateLongitude = _form.CandidateLongitude,
            EffectiveOn = _form.EffectiveOn,
            OriginGeographySnapshotId = _form.OriginGeographySnapshotId,
            AgePopulationSnapshotId = _form.AgePopulationSnapshotId,
            IncomeSnapshotId = _form.IncomeSnapshotId,
            CompetitorSnapshotId = _form.CompetitorSnapshotId,
            ObservedPerformanceSnapshotId = _form.ObservedPerformanceSnapshotId,
            TourismSnapshotId = _form.TourismSnapshotId,
            TrafficSnapshotId = _form.TrafficSnapshotId,
            LocalEconomicInventorySnapshotId = _form.LocalEconomicInventorySnapshotId,
            NationalParameterSetId = _form.NationalParameterSetId,
            JurisdictionParameterSetId = _form.JurisdictionParameterSetId,
            ScenarioParameterSetId = _form.ScenarioParameterSetId,
            FacilityRegime = _form.FacilityRegime,
            DemandSpecification = _form.DemandSpecification,
            AttractionSpecification = _form.AttractionSpecification,
            FrictionForm = _form.FrictionForm,
            ObservedMetricKey = _form.ObservedMetricKey,
            UserOverrides = new Dictionary<string, double>(_overrides, StringComparer.Ordinal)
        };
        _scenarioJson = JsonSerializer.Serialize(document, ScenarioJsonOptions);
        _scenarioJsonMessage = $"Exported {_overrides.Count} override(s) using {ScenarioDefinitionDocument.CurrentSchemaVersion}.";
        _scenarioJsonError = false;
    }

    private async Task ImportScenarioDefinitionAsync()
    {
        _scenarioJsonMessage = null;
        _scenarioJsonError = false;
        try
        {
            if (_configuration is null)
            {
                throw new InvalidOperationException("The model catalog must be loaded before importing a scenario.");
            }
            var document = JsonSerializer.Deserialize<ScenarioDefinitionDocument>(_scenarioJson, ScenarioJsonOptions)
                           ?? throw new InvalidDataException("The scenario JSON was empty or invalid.");
            ValidateScenarioDefinition(document, _configuration);

            _form.ScenarioName = document.ScenarioName.Trim();
            _form.JurisdictionCode = document.JurisdictionCode;
            _form.OriginStateCode = document.OriginStateCode;
            _form.DevelopmentProgramId = document.DevelopmentProgramId;
            _form.CandidateLatitude = document.CandidateLatitude;
            _form.CandidateLongitude = document.CandidateLongitude;
            _form.EffectiveOn = document.EffectiveOn;
            _form.OriginGeographySnapshotId = document.OriginGeographySnapshotId;
            _form.AgePopulationSnapshotId = document.AgePopulationSnapshotId;
            _form.IncomeSnapshotId = document.IncomeSnapshotId;
            _form.CompetitorSnapshotId = document.CompetitorSnapshotId;
            _form.ObservedPerformanceSnapshotId = document.ObservedPerformanceSnapshotId;
            _form.TourismSnapshotId = document.TourismSnapshotId;
            _form.TrafficSnapshotId = document.TrafficSnapshotId;
            _form.LocalEconomicInventorySnapshotId = document.LocalEconomicInventorySnapshotId;
            _form.NationalParameterSetId = document.NationalParameterSetId;
            _form.JurisdictionParameterSetId = document.JurisdictionParameterSetId;
            _form.ScenarioParameterSetId = document.ScenarioParameterSetId;
            _form.FacilityRegime = document.FacilityRegime;
            _form.DemandSpecification = document.DemandSpecification;
            _form.AttractionSpecification = document.AttractionSpecification;
            _form.FrictionForm = document.FrictionForm;
            _form.ObservedMetricKey = document.ObservedMetricKey;
            _overrides.Clear();
            foreach (var (key, value) in document.UserOverrides)
            {
                _overrides.Add(key, value);
            }

            await LoadOriginsAsync();
            await LoadTourismAsync();
            await LoadTrafficAsync();
            _latestRun = null;
            _lastRunRequest = null;
            _sensitivityResult = null;
            _reportArtifact = null;
            _scenarioJsonMessage = $"Imported {document.UserOverrides.Count} override(s). Run the scenario to create a new immutable result.";
        }
        catch (Exception exception) when (exception is JsonException or InvalidDataException or InvalidOperationException or ArgumentException)
        {
            _scenarioJsonMessage = exception.Message;
            _scenarioJsonError = true;
        }
    }

    private static void ValidateScenarioDefinition(
        ScenarioDefinitionDocument document,
        ModelConfiguration configuration)
    {
        if (!string.Equals(document.SchemaVersion, ScenarioDefinitionDocument.CurrentSchemaVersion, StringComparison.Ordinal))
        {
            throw new InvalidDataException($"Unsupported scenario schema '{document.SchemaVersion}'. Expected '{ScenarioDefinitionDocument.CurrentSchemaVersion}'.");
        }
        if (!string.Equals(document.ModelVersion, configuration.ModelVersion, StringComparison.Ordinal))
        {
            throw new InvalidDataException($"Scenario model version '{document.ModelVersion}' does not match '{configuration.ModelVersion}'.");
        }
        if (string.IsNullOrWhiteSpace(document.ScenarioName) || string.IsNullOrWhiteSpace(document.JurisdictionCode) ||
            !configuration.Jurisdictions.Any(item => item.Code == document.JurisdictionCode))
        {
            throw new InvalidDataException("The scenario name and a catalog-backed jurisdiction are required.");
        }
        if (document.DevelopmentProgramId is not { } programId ||
            !configuration.DevelopmentPrograms.Any(item => item.Id == programId))
        {
            throw new InvalidDataException("The imported development program is not available in the current catalog.");
        }
        if (document.CandidateLatitude is not (>= -90 and <= 90) || document.CandidateLongitude is not (>= -180 and <= 180))
        {
            throw new InvalidDataException("Imported candidate coordinates are missing or outside valid latitude/longitude bounds.");
        }
        if (document.EffectiveOn.Year is < 1900 or > 2200)
        {
            throw new InvalidDataException("The fiscal rule effective date must be between 1900 and 2200.");
        }
        if (document.UserOverrides is null)
        {
            throw new InvalidDataException("Imported userOverrides must be a JSON object.");
        }
        if (document.DemandSpecification is not ("agi-share" or "eligible-adult-per-capita") ||
            document.AttractionSpecification is not ("observed-ggr" or "structural") ||
            document.FrictionForm is not ("inverse-power" or "exponential"))
        {
            throw new InvalidDataException("The imported demand, attraction, or travel-friction specification is not supported.");
        }
        ValidateSnapshot(configuration, document.OriginGeographySnapshotId, "origin-geography", true);
        ValidateSnapshot(configuration, document.AgePopulationSnapshotId, "age-population", true);
        ValidateSnapshot(configuration, document.IncomeSnapshotId, "income", true);
        ValidateSnapshot(configuration, document.CompetitorSnapshotId, "competitors", true);
        ValidateSnapshot(configuration, document.ObservedPerformanceSnapshotId, "observed-performance", true);
        ValidateSnapshot(configuration, document.TourismSnapshotId, "tourism", false);
        ValidateSnapshot(configuration, document.TrafficSnapshotId, "traffic", false);
        ValidateSnapshot(configuration, document.LocalEconomicInventorySnapshotId, "local-economic-inventory", false);
        ValidateParameterSet(configuration, document.NationalParameterSetId, "national");
        ValidateParameterSet(configuration, document.JurisdictionParameterSetId, "jurisdiction");
        ValidateParameterSet(configuration, document.ScenarioParameterSetId, "scenario");

        foreach (var (key, value) in document.UserOverrides)
        {
            var definition = configuration.ParameterDefinitions.SingleOrDefault(item => item.Key == key)
                             ?? throw new InvalidDataException($"Imported override '{key}' is not active in the current model catalog.");
            if (!definition.IsUserOverridable || !double.IsFinite(value))
            {
                throw new InvalidDataException($"Imported override '{key}' is not a finite user-overridable value.");
            }
            if (definition.ComputationalMinimum is { } minimum && value < minimum ||
                definition.ComputationalMaximum is { } maximum && value > maximum)
            {
                throw new InvalidDataException($"Imported override '{key}' is outside its hard computational bounds.");
            }
        }
    }

    private static void ValidateSnapshot(
        ModelConfiguration configuration,
        Guid? snapshotId,
        string expectedKind,
        bool required)
    {
        if (snapshotId is null)
        {
            if (required)
            {
                throw new InvalidDataException($"A sealed '{expectedKind}' snapshot is required.");
            }
            return;
        }
        if (!configuration.Snapshots.Any(item => item.Id == snapshotId && item.DatasetKey == expectedKind))
        {
            throw new InvalidDataException($"Snapshot '{snapshotId}' is not an available '{expectedKind}' snapshot.");
        }
    }

    private static void ValidateParameterSet(ModelConfiguration configuration, long? setId, string expectedScope)
    {
        if (setId is not null && !configuration.ParameterSets.Any(item => item.Id == setId && item.Scope == expectedScope))
        {
            throw new InvalidDataException($"Parameter set '{setId}' is not an available '{expectedScope}' layer.");
        }
    }

    private IEnumerable<ParameterDefinition> StandardDefinitions()
    {
        if (_configuration is null)
        {
            return [];
        }

        return _configuration.ParameterDefinitions
            .Where(definition => StandardParameterKeys.Contains(definition.Key, StringComparer.Ordinal))
            .OrderBy(definition => Array.IndexOf(StandardParameterKeys, definition.Key));
    }

    private IEnumerable<ParameterDefinition> AdvancedDefinitions()
    {
        if (_configuration is null)
        {
            return [];
        }
        return _configuration.ParameterDefinitions
            .Where(definition => !StandardParameterKeys.Contains(definition.Key, StringComparer.Ordinal))
            .Where(definition => string.IsNullOrWhiteSpace(_parameterSearch) ||
                                 definition.Key.Contains(_parameterSearch, StringComparison.OrdinalIgnoreCase) ||
                                 definition.DisplayName.Contains(_parameterSearch, StringComparison.OrdinalIgnoreCase) ||
                                 definition.Category.Contains(_parameterSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(definition => definition.Category)
            .ThenBy(definition => definition.DisplayName);
    }

    private RenderFragment ParameterEditor(ParameterDefinition Definition) => builder =>
    {
        var sequence = 0;
        var value = ParameterValue(Definition);
        var scenarioValue = ParameterScenarioValue(Definition);
        var overridden = _overrides.ContainsKey(Definition.Key);
        var outside = Definition.RecommendedMinimum is { } minimum && value < minimum ||
                      Definition.RecommendedMaximum is { } maximum && value > maximum;
        var inputId = $"model-parameter-{Definition.Key.Replace('.', '-')}";
        builder.OpenElement(sequence++, "article");
        builder.AddAttribute(sequence++, "class", $"model-parameter{(overridden ? " is-overridden" : "")}{(outside ? " is-outside-range" : "")}");

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "model-parameter-heading");
        builder.OpenElement(sequence++, "label");
        builder.AddAttribute(sequence++, "for", inputId);
        builder.AddContent(sequence++, Definition.DisplayName);
        builder.CloseElement();
        if (overridden)
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", "model-link-button");
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ResetOverride(Definition.Key)));
            builder.AddContent(sequence++, "Reset");
            builder.CloseElement();
        }
        builder.CloseElement();

        builder.OpenElement(sequence++, "input");
        builder.AddAttribute(sequence++, "id", inputId);
        builder.AddAttribute(sequence++, "type", "number");
        builder.AddAttribute(sequence++, "step", Definition.UiStep ?? 0.01);
        builder.AddAttribute(sequence++, "disabled", !Definition.IsUserOverridable);
        if (Definition.ComputationalMinimum is { } hardMinimum) builder.AddAttribute(sequence++, "min", hardMinimum);
        if (Definition.ComputationalMaximum is { } hardMaximum) builder.AddAttribute(sequence++, "max", hardMaximum);
        builder.AddAttribute(sequence++, "value", value.ToString(CultureInfo.InvariantCulture));
        builder.AddAttribute(sequence++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, args => SetOverride(Definition, args.Value?.ToString())));
        builder.CloseElement();

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "model-parameter-state");
        builder.AddContent(sequence++, outside
            ? "Outside recommended range — the backend run will preserve and report this warning."
            : overridden
                ? "Custom override — the next backend run will store this exact value."
                : $"{ParameterSource(Definition.Key)} value.");
        builder.CloseElement();

        builder.OpenElement(sequence++, "small");
        builder.AddContent(sequence++, $"{Definition.Units} · base {Definition.SystemDefaultValue:G6} · scenario {scenarioValue:G6} · recommended {Range(Definition)}");
        builder.CloseElement();

        builder.OpenElement(sequence++, "details");
        builder.AddAttribute(sequence++, "class", "model-parameter-metadata");
        builder.OpenElement(sequence++, "summary");
        builder.AddContent(sequence++, "Interpretation and provenance");
        builder.CloseElement();
        builder.OpenElement(sequence++, "p");
        builder.AddContent(sequence++, Definition.PlainLanguageDescription);
        builder.CloseElement();
        builder.OpenElement(sequence++, "dl");
        AddMetadata(builder, ref sequence, "Parameter key", Definition.Key);
        AddMetadata(builder, ref sequence, "Exposure", Definition.UiExposureLevel);
        AddMetadata(builder, ref sequence, "Calibration", Definition.IsCalibrated ? "Calibrated" : "Provisional / not calibrated");
        AddMetadata(builder, ref sequence, "Hard bounds", ComputationalRange(Definition));
        AddMetadata(builder, ref sequence, "Selected source", ParameterSource(Definition.Key));
        builder.CloseElement();
        builder.OpenElement(sequence++, "p");
        builder.AddAttribute(sequence++, "class", "model-parameter-provenance");
        builder.AddContent(sequence++, string.IsNullOrWhiteSpace(Definition.ProvenanceNotes)
            ? "No provenance note is available."
            : Definition.ProvenanceNotes);
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private static void AddMetadata(RenderTreeBuilder builder, ref int sequence, string term, string value)
    {
        builder.OpenElement(sequence++, "div");
        builder.OpenElement(sequence++, "dt");
        builder.AddContent(sequence++, term);
        builder.CloseElement();
        builder.OpenElement(sequence++, "dd");
        builder.AddContent(sequence++, value);
        builder.CloseElement();
        builder.CloseElement();
    }

