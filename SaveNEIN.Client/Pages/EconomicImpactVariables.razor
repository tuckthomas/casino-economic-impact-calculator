@page "/economic-impact/variables"
<PageTitle>Economic Impact Variables | Save Northeast Indiana</PageTitle>
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using SaveNEIN.Shared
@using SaveNEIN.Client.Pages
@using System.Text.Json

    <section class="bg-[#0f172a] relative overflow-hidden" id="economic-analysis">
        <div class="economic-analysis-body mx-auto max-w-7xl px-0 pt-24 pb-24 sm:pt-28 sm:pb-28 lg:px-8">
            <div class="economic-analysis-section-content">
                <div class="section-heading-block economic-analysis-section-heading mb-12 text-center max-w-4xl mx-auto" id="economic-analysis-header">
                    <span class="text-blue-500 font-bold tracking-wider uppercase text-sm mb-2 block">Economic
                        Analysis</span>
                    <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
                        ECONOMIC <span class="text-blue-500">IMPACT</span> CALCULATOR
                    </h2>
                    <p class="section-heading-description mt-4 text-xl italic text-slate-400 font-medium w-full max-w-none md:max-w-2xl md:mx-auto">
                        Interactive modeling of the social and financial impact on counties and states.
                    </p>
                    @if (_scenario is not null)
                    {
                        <div class="mx-auto mt-5 max-w-2xl rounded-xl border border-slate-700 bg-slate-900/70 p-4 text-left text-sm text-slate-300">
                            <strong class="text-white">Part 1 location loaded.</strong>
                            <span class="ml-1">@(_scenario.StateFips ?? "Selected region")@(_scenario.CountyFips is null ? "" : $" / county {_scenario.CountyFips}")</span>
                            <span class="ml-2 text-slate-500">Zone settings are carried into this analysis.</span>
                        </div>
                    }
                </div>

                <div class="economic-analysis-content">
                    <div class="economic-analysis-opening-shell">
                        <div class="economic-analysis-opening">
                            <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-6 text-slate-300"><h3 class="text-xl font-bold text-white">Location saved from Part 1</h3><p class="mt-2 text-slate-400">The map and impact-zone settings are selected on the previous step.</p><a class="mt-4 inline-flex rounded-lg bg-orange-600 px-5 py-3 font-bold text-white hover:bg-orange-500" href="/economic-impact/location">Edit location and zones</a></div>
                        </div>
                    </div>

                    <div class="economic-analysis-content-shell">
                    <!-- Calculator Grid -->
                    <div class="flex flex-col gap-12 mb-16 pb-24">

            <!-- Controls Card -->
            <div id="calculator-controls"
                class="economic-chart-card w-full">
                <h3 class="text-xl font-bold text-slate-300 dark:text-white mb-2">
                    <span class="material-symbols-outlined text-blue-500">tune</span>
                    Economic Inputs
                </h3>
                <div class="space-y-5">
                    <!-- County is selected through the Map component above -->
                    <!-- Simulator Trigger -->
                    <div class="-mb-8">
                        <button onclick="openSimulatorModal()"
                            class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-bold py-4 px-6 rounded-xl shadow-lg shadow-blue-500/20 border border-blue-400/30 flex items-center justify-between group transition-all transform active:scale-95 mt-10">
                            <div class="flex items-center gap-3">
                                <div class="bg-white/20 p-2 rounded-lg">
                                    <span class="material-symbols-outlined text-white">science</span>
                                </div>
                                <div class="text-left">
                                    <div class="uppercase tracking-wide text-sm font-bold text-blue-100 mb-0.5">Quick
                                        Start</div>
                                    <div class="text-lg leading-none">Run Scenario Simulator</div>
                                </div>
                            </div>
                            <span
                                class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                        </button>

                        <div class="relative flex py-8 items-center justify-center mt-10">
                            <div class="absolute inset-0 flex items-center" aria-hidden="true">
                                <div class="w-full border-t border-slate-700"></div>
                            </div>
                            <div class="relative flex justify-center">
                                <button @onclick="ToggleManualControls" id="btn-manual-toggle"
                                    class="bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-bold py-2 px-6 rounded-full border border-purple-400/30 flex items-center gap-2 transition-all text-sm uppercase tracking-wider group shadow-lg active:scale-95">
                                    <span>Adjust Variables Manually</span>
                                    <span
                                        class="material-symbols-outlined group-hover:translate-y-1 transition-transform text-lg @(_manualControlsExpanded ? "rotate-180" : "")">expand_more</span>
                                </button>
                            </div>
                        </div>

                        <!-- Collapsible Manual Controls -->
                        <div id="manual-controls"
                            class="rounded-2xl px-4 sm:px-6 py-8 transition-all duration-500 ease-in-out @(_manualControlsExpanded ? "max-h-[8000px] opacity-100 overflow-visible" : "max-h-0 opacity-0 overflow-hidden")">

                        <div class="economic-chart-card mb-8">
                            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                                <div class="max-w-3xl">
                                    <h4 class="flex items-center gap-2 text-lg font-bold text-white">
                                        <span class="material-symbols-outlined text-cyan-400">account_balance</span>
                                        Tax Allocation Scenario
                                    </h4>
                                    <p class="mt-2 text-sm leading-relaxed text-slate-400">
                                        Choose the tax-allocation regime that determines how public revenue is distributed. This changes only the revenue split logic, not the social-cost model.
                                    </p>
                                </div>
                                <div class="w-full max-w-sm">
                                    <label for="tax-allocation-scenario-select" class="mb-2 block text-sm font-bold uppercase tracking-wide text-slate-300">
                                        Active Scenario
                                    </label>
                                    <select id="tax-allocation-scenario-select"
                                        aria-hidden="true"
                                        tabindex="-1"
                                        class="hidden">
                                    </select>
                                    <div class="relative block">
                                        <button type="button"
                                            id="tax-allocation-scenario-trigger"
                                            class="sfw-modern-select sfw-modern-select-trigger w-full px-4 py-3 text-base font-semibold"
                                            aria-label="Active tax allocation scenario"
                                            aria-haspopup="listbox"
                                            aria-expanded="false"
                                            aria-controls="tax-allocation-scenario-menu">
                                            <span id="tax-allocation-scenario-trigger-label" class="truncate">Loading scenarios...</span>
                                            <span id="tax-allocation-scenario-trigger-icon" class="material-symbols-outlined text-[18px] transition-transform" aria-hidden="true">expand_more</span>
                                        </button>
                                        <div id="tax-allocation-scenario-menu" role="listbox"
                                            class="sfw-custom-select-menu hidden mt-2"></div>
                                    </div>
                                </div>
                            </div>
                            <p id="tax-allocation-scenario-summary" class="mt-4 text-sm leading-relaxed text-slate-400"></p>
                            <div id="tax-allocation-validation" class="hidden"></div>
                            <div id="tax-allocation-custom-editor" class="mt-6 grid gap-4"></div>
                        </div>
                        
                        <!-- Revenue Potential Alert (Populated by JS) -->
                        <div id="revenue-potential-alert" class="hidden mb-6 p-4 rounded-xl border-l-4">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined mt-0.5 text-xl" id="revenue-alert-icon">info</span>
                                <div>
                                    <h4 class="font-bold text-white mb-1" id="revenue-alert-title">Location Assessment</h4>
                                    <p class="text-sm text-slate-300" id="revenue-alert-message">Assessing relative revenue potential...</p>
                                </div>
                            </div>
                        </div>

                        <!-- AGR Input -->
                        <div class="border-b border-slate-700 pb-8">
                            <PresetInput Id="agr" Label="Adjusted Gross Revenue (AGR)" Value="204.3"
                                         MinValue="0" MaxValue="1000" Step="0.01"
                                         InputType="MoneyMM" DecimalPlaces="2"
                                         MajorTickInterval="200"
                                         Tooltip="Total gambling losses from all players, before taxes and expenses."
                                         Markers='@(new List<SliderMarker> { new() { Label="Default", Value=204.3, TooltipDescription="Spectrum Gaming Projection" } })' />

                            <!-- AGR Sensitivity Presets -->
                            <div class="mt-16 mb-4">
                                <label class="text-sm font-bold text-slate-300 mb-2 block">Steuben County Benchmark AGR Scenarios</label>
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                    <button type="button" data-agr-preset="steubenLow" onclick="window.applyAgrPreset(188.6, 'Steuben Low', 'steubenLow')" class="text-sm py-2 px-3 rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white transition-colors">Steuben Low (188.6)</button>
                                    <button type="button" data-agr-preset="steubenBase" onclick="window.applyAgrPreset(203.1, 'Steuben Base', 'steubenBase')" class="text-sm py-2 px-3 rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white transition-colors">Steuben Base (203.1)</button>
                                    <button type="button" data-agr-preset="steubenHigh" onclick="window.applyAgrPreset(214.0, 'Steuben High', 'steubenHigh')" class="text-sm py-2 px-3 rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white transition-colors">Steuben High (214.0)</button>
                                </div>
                                <p class="text-sm text-slate-400 mt-4 italic">
                                    <strong>Methodology Note:</strong> These benchmark presets are Steuben County market-feasibility GGR/AGR scenarios from the A.M. Steinberg Advisors study (March 5, 2026). They are provided for scenario testing and do not represent validated economic-impact conclusions.
                                </p>

                                <details class="mt-4 rounded-lg border border-slate-700 bg-slate-900/60 p-3 text-sm text-slate-300">
                                    <summary class="cursor-pointer font-semibold text-slate-200">What does the ZIP-by-ZIP switching model mean?</summary>
                                    <div class="mt-3 space-y-2 text-slate-300 leading-relaxed">
                                        <p><strong>ZIP Demand Pool:</strong> An estimate of gambling demand from each ZIP code based on adult population and scenario inputs.</p>
                                        <p><strong>Venue Utility Score:</strong> A relative attractiveness score that goes up for stronger casino offerings and down as travel distance increases.</p>
                                        <p><strong>Share Allocation:</strong> For each ZIP code, the model splits demand across the proposed casino and existing competitors based on relative utility.</p>
                                        <p><strong>Projected GGR/AGR:</strong> The model sums the proposed site's ZIP-level shares into a scenario estimate. Treat this as directional scenario analysis, not a precise forecast.</p>
                                    </div>
                                </details>
                            </div>

                            <!-- Tax Details (Always Visible) -->
                            <div id="tax-details-container"
                                class="bg-slate-900/80 rounded-lg p-4 mt-20 text-sm font-mono text-slate-300 border border-slate-700 shadow-inner">
                                <!-- Populated by JS -->
                            </div>
                        </div>

                        <!-- Revenue Input -->
                        <div class="border-b border-slate-700 pb-8 mt-8">
                            <PresetInput Id="revenue" Label="Tax Revenue" Value="61.21"
                                         MinValue="0" MaxValue="400" Step="0.01"
                                         InputType="MoneyMM" DecimalPlaces="2"
                                         MajorTickInterval="100"
                                         Tooltip="The portion of AGR collected by the state and local government."
                                         Markers='@(new List<SliderMarker> { new() { Label="Default", Value=61.21, TooltipDescription="Spectrum Gaming Projection" } })' />
                        </div>

                        <div class="pt-6 mt-10 rounded-xl border border-slate-700 bg-slate-900/60 p-4">
                            <label class="text-base font-bold text-white block mb-2">Revenue Allocation Model</label>
                            <p class="text-sm text-slate-400 italic">
                                Use the Tax Allocation Scenario controls below to choose which public-revenue split is applied after total tax revenue is estimated. Municipality-directed allocations depend on incorporated PLACE containment, not just county selection.
                            </p>
                            <input type="hidden" value="0" id="input-allocation" aria-hidden="true">
                        </div>

                        <!-- Social Cost Input -->
                        <div class="pb-10">
                            <div class="mb-4 mt-10">
                                <label class="text-base font-bold text-white block mb-2">Social Cost
                                    Variables (Per Problem Gambler)</label>
                                <div class="flex justify-between items-baseline mb-2 bg-slate-800 p-2 rounded-lg">
                                    <span class="text-sm font-bold text-slate-500 uppercase">Total Cost</span>
                                    <span class="text-red-500 font-bold font-mono text-lg"
                                        id="val-cost-total">$13,203</span>
                                </div>
                                <p class="text-sm text-slate-400 italic mb-4">Default values based on Grinols (2011)
                                    ($9,393) adjusted for 2025 inflation ($13,205).</p>
                            </div>

                            <div class="space-y-12 pl-2">
                                <PresetInput Id="cost-crime" Label="Crime Costs" Value="1625" 
                                             MinValue="0" MaxValue="10000" Step="1"
                                             InputType="Currency" DecimalPlaces="0"
                                             MajorTickInterval="2000"
                                             Tooltip="Includes costs for police, adjudication, and incarceration related to gambling-induced crime." 
                                             Markers='@(new List<SliderMarker> { new() { Label="Default", Value=1625, TooltipDescription="This is the inflation-adjusted default value based on Grinols (2011)." } })' />

                                <PresetInput Id="cost-business" Label="Lost Employment" Value="4051" 
                                             MinValue="0" MaxValue="10000" Step="1"
                                             InputType="Currency" DecimalPlaces="0"
                                             MajorTickInterval="2000"
                                             Tooltip="Economic losses due to lost productivity, absenteeism, and unemployment." 
                                             Markers='@(new List<SliderMarker> { new() { Label="Default", Value=4051, TooltipDescription="This is the inflation-adjusted default value based on Grinols (2011)." } })' />

                                <PresetInput Id="cost-bankruptcy" Label="Bankruptcy" Value="431" 
                                             MinValue="0" MaxValue="10000" Step="1"
                                             InputType="Currency" DecimalPlaces="0"
                                             MajorTickInterval="2000"
                                             Tooltip="Legal costs and resource drain associated with filings, debts, and civil proceedings." 
                                             Markers='@(new List<SliderMarker> { new() { Label="Default", Value=431, TooltipDescription="This is the inflation-adjusted default value based on Grinols (2011)." } })' />

                                <PresetInput Id="cost-illness" Label="Illness" Value="1328" 
                                             MinValue="0" MaxValue="10000" Step="1"
                                             InputType="Currency" DecimalPlaces="0"
                                             MajorTickInterval="2000"
                                             Tooltip="Healthcare costs for treating stress-related disorders, depression, and anxiety." 
                                             Markers='@(new List<SliderMarker> { new() { Label="Default", Value=1328, TooltipDescription="This is the inflation-adjusted default value based on Grinols (2011)." } })' />

                                <PresetInput Id="cost-services" Label="Social Services" Value="713" 
                                             MinValue="0" MaxValue="10000" Step="1"
                                             InputType="Currency" DecimalPlaces="0"
                                             MajorTickInterval="2000"
                                             Tooltip="Public costs for unemployment benefits, welfare programs, and social safety nets." 
                                             Markers='@(new List<SliderMarker> { new() { Label="Default", Value=713, TooltipDescription="This is the inflation-adjusted default value based on Grinols (2011)." } })' />

                                <PresetInput Id="cost-abused" Label="Abused Dollars" Value="5055" 
                                             MinValue="0" MaxValue="10000" Step="1"
                                             InputType="Currency" DecimalPlaces="0"
                                             MajorTickInterval="2000"
                                             Tooltip="Financial impact of 'borrowed' or stolen family funds, plus divorce and domestic instability costs." 
                                             Markers='@(new List<SliderMarker> { new() { Label="Default", Value=5055, TooltipDescription="This is the inflation-adjusted default value based on Grinols (2011)." } })' />
                            </div>

                            <!-- Tax Revenue Calculation -->
                            <div id="calc-tax-revenue-container"
                                class="hidden mt-20 mb-6 relative z-10 bg-slate-900/50 rounded-xl p-4 border border-slate-600">
                                <div
                                    class="text-sm text-slate-400 uppercase tracking-widest font-bold mb-4 text-center">
                                    Tax Revenue Calculation</div>
	                                        <div
	                                            class="grid grid-cols-[1fr_auto_1fr_auto_1fr] gap-2 items-center text-sm">
	                                            <div class="flex flex-col items-center">
	                                                <span
                                            class="text-slate-500 uppercase font-bold mb-1 text-center">Adjusted
                                            Gross Revenue</span>
                                        <span class="text-white font-mono font-bold" id="calc-agr">-</span>
                                    </div>
                                    <div class="text-slate-500 font-bold mb-3">×</div>
                                    <div class="flex flex-col items-center">
                                        <span
                                            class="text-slate-500 uppercase font-bold mb-1 text-center">Effective
                                            Tax Rate</span>
                                        <span class="text-white font-mono font-bold" id="calc-tax-rate">-</span>
                                    </div>
                                    <div class="text-slate-500 font-bold mb-3">=</div>
                                    <div class="flex flex-col items-center">
                                        <span class="text-slate-500 uppercase font-bold mb-1 text-center">Total
                                            Estimated Tax Revenue</span>
                                        <span class="text-white font-mono font-bold" id="calc-tax-total">-</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Calculation Breakdown -->
                            <div id="calc-problem-gambler-container"
                                class="hidden mb-6 relative z-10 bg-slate-900/50 rounded-xl p-4 border border-slate-600">
                                <div
                                    class="text-sm text-slate-400 uppercase tracking-widest font-bold mb-4 text-center">
                                    Problem Gambler Calculation</div>
                                <div
                                    class="grid grid-cols-[1fr_auto_1fr_auto_1fr] gap-2 items-center text-sm">
                                    <div class="flex flex-col items-center">
                                        <span class="text-slate-500 uppercase font-bold mb-1 text-center">Total
                                            Population</span>
                                        <span class="text-white font-mono font-bold" id="calc-pop">-</span>
                                    </div>
                                    <div class="text-slate-500 font-bold mb-3">×</div>
                                    <div class="flex flex-col items-center">
                                        <span
                                            class="text-slate-500 uppercase font-bold mb-1 text-center">Effective
                                            Rate</span>
                                        <span class="text-white font-mono font-bold" id="calc-rate">-</span>
                                    </div>
                                    <div class="text-slate-500 font-bold mb-3">=</div>
                                    <div class="flex flex-col items-center">
                                        <span class="text-slate-500 uppercase font-bold mb-1 text-center">New
                                            Problem Gamblers</span>
                                        <span class="text-white font-mono font-bold" id="calc-result">-</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Detailed Social Cost Breakdown -->
                            <div id="detailed-breakdown-empty-state" class="p-8 text-center bg-slate-800/30 rounded-xl border border-dashed border-slate-700 mt-16 mb-8">
                                <p class="text-slate-500 text-sm italic">
                                    Breakdown details will be populated once a location is selected.
                                </p>
                            </div>

                            <div id="detailed-breakdown-content" class="hidden mb-8 relative z-10 bg-slate-900/50 rounded-xl p-4 border border-slate-600">
                                <div
                                    class="text-sm text-slate-400 uppercase tracking-widest font-bold mb-4 text-center">
                                    Detailed Social Cost Breakdown — Subject County
                                </div>

                                <div class="space-y-6 mb-8">
                                    <!-- 1. Public Health -->
                                    <div>
                                        <div class="text-slate-500 uppercase font-bold mb-2 text-center">Public
                                            Health (Base-Case Public Health Burden)</div>
                                        <div
                                            class="grid grid-cols-[1fr_auto_1fr_auto_1fr] gap-2 items-center text-sm">
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">New
                                                    Problem Gamblers</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-health-victims">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">×</div>
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">Cost/Problem
                                                    Gambler</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-health-per">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">=</div>
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">Total
                                                    Cost</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-health-total">-</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. Social Services -->
                                    <div class="border-t border-slate-700/50 pt-4">
                                        <div class="text-slate-500 uppercase font-bold mb-2 text-center">Social
                                            Services (Welfare, Unemployment)</div>
                                        <div
                                            class="grid grid-cols-[1fr_auto_1fr_auto_1fr] gap-2 items-center text-sm">
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">New
                                                    Problem Gamblers</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-social-victims">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">×</div>
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">Cost/Problem
                                                    Gambler</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-social-per">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">=</div>
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">Total
                                                    Cost</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-social-total">-</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 3. Criminal Justice -->
                                    <div class="border-t border-slate-700/50 pt-4">
                                        <div class="text-slate-500 uppercase font-bold mb-2 text-center">Law
                                            Enforcement (Police, Courts, Jail)</div>
                                        <div
                                            class="grid grid-cols-[1fr_auto_1fr_auto_1fr] gap-2 items-center text-sm">
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">New
                                                    Problem Gamblers</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-crime-victims">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">×</div>
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">Cost/Problem
                                                    Gambler</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-crime-per">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">=</div>
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">Total
                                                    Cost</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-crime-total">-</span>
                                            </div>
                                        </div>
	                                    </div>

                                    <!-- 4. Civil Legal -->
                                    <div class="border-t border-slate-700/50 pt-4">
                                        <div class="text-slate-500 uppercase font-bold mb-2 text-center">Civil
                                            Legal (Courts, Bankruptcy)</div>
                                        <div
                                            class="grid grid-cols-[1fr_auto_1fr_auto_1fr] gap-2 items-center text-sm">
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">New
                                                    Problem Gamblers</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-legal-victims">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">×</div>
                                            <div class="flex flex-col items-center">
                                                <span
                                                    class="text-slate-500 uppercase font-bold mb-1 text-center">Cost/Problem
                                                    Gambler</span>
                                                <span class="text-white font-mono font-bold"
                                                    id="calc-break-legal-per">-</span>
                                            </div>
                                            <div class="text-slate-500 font-bold mb-3">=</div>
