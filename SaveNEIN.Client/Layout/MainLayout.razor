@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="bg-slate-900 dark:bg-background-dark min-h-screen text-slate-900 dark:text-slate-100 font-display selection:bg-accent selection:text-black">
    @if (!IsHomeRoute)
    {
    <header class="sticky top-0 z-50 w-full border-b border-white/5 bg-slate-950/90 backdrop-blur-md text-white shadow-lg shadow-black/20">
        <nav class="w-full text-white">
            <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-3 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
                <div class="flex items-center justify-between gap-4">
                    <a class="flex items-center gap-3 group shrink-0" href="/">
                        <img src="assets/SaveNEIN_SVG_Dark_Mode_Small.svg" alt="Save Northeast Indiana" class="h-12 w-auto object-contain" />
                    </a>
                    <div class="flex items-center lg:hidden">
                        <a href="https://github.com/tuckthomas/casino-economic-impact-calculator.git" target="_blank" rel="noopener noreferrer"
                            class="flex size-10 items-center justify-center rounded-lg border border-slate-700 text-slate-400 hover:text-white hover:border-slate-500 transition-colors"
                            id="mobile-main-github-source-link" aria-label="View Source on GitHub">
                            <svg class="size-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill-rule="evenodd" clip-rule="evenodd"
                                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z">
                                </path>
                            </svg>
                        </a>
                        <AppTooltip TargetId="mobile-main-github-source-link" Text="View Source on GitHub" />
                    </div>
                </div>
                <div class="-mx-4 overflow-x-auto overflow-y-hidden px-4 scrollbar-none [scrollbar-width:none] [-webkit-overflow-scrolling:touch] min-w-0 lg:mx-0 lg:px-0">
                    <div class="flex items-center min-w-max pb-0.5 lg:pb-0 gap-1 sm:gap-2">
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/">Home</a>
                        <span class="text-slate-600 select-none">|</span>
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/archive">Archive</a>
                        <span class="text-slate-600 select-none">|</span>
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/#casino-fact-checks">Fact Check</a>
                        <span class="text-slate-600 select-none">|</span>
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/#casino-substitution-effect">Substitution Effect</a>
                        <span class="text-slate-600 select-none">|</span>
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/economic-impact/variables">Scenario Comparison</a>
                        <span class="text-slate-600 select-none">|</span>
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/#casino-voter-opinion">Polling Results</a>
                        <span class="text-slate-600 select-none">|</span>
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/#casino-public-safety">Crime & Safety</a>
                        <span class="text-slate-600 select-none">|</span>
                        <a class="relative inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors whitespace-nowrap"
                            href="/economic-impact/location">Economic Impact Model</a>
                    </div>
                </div>
                <div class="hidden items-center lg:flex">
                    <a href="https://github.com/tuckthomas/casino-economic-impact-calculator.git" target="_blank" rel="noopener noreferrer"
                        class="flex size-10 items-center justify-center rounded-lg border border-slate-700 text-slate-400 hover:text-white hover:border-slate-500 transition-colors"
                        id="desktop-main-github-source-link" aria-label="View Source on GitHub">
                        <svg class="size-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" clip-rule="evenodd"
                                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z">
                            </path>
                        </svg>
                    </a>
                    <AppTooltip TargetId="desktop-main-github-source-link" Text="View Source on GitHub" />
                </div>
            </div>
        </nav>
    </header>
    }

    @Body
</div>

@code {
    private bool IsHomeRoute
    {
        get
        {
            var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            relative = relative.Split('?')[0].Split('#')[0];
            return string.IsNullOrEmpty(relative);
        }
    }
}
